# syntax=docker/dockerfile:1.7
FROM rust:1.96-slim AS shell-builder

RUN apt-get -o Acquire::ForceIPv4=true update && \
    apt-get -o Acquire::ForceIPv4=true install --yes --no-install-recommends \
        libxkbcommon-dev \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /source
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --locked --release -p wildbuzzard-shell

FROM rust:1.96-slim AS cua-builder

RUN apt-get -o Acquire::ForceIPv4=true update && \
    apt-get -o Acquire::ForceIPv4=true install --yes --no-install-recommends \
        libx11-dev \
        libxfixes-dev \
        libxi-dev \
        libxkbcommon-dev \
        libxrandr-dev \
        libxtst-dev \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /source
COPY third_party/trycua-cua/cua-driver/rust ./cua-driver/rust
RUN cargo build \
        --locked \
        --release \
        --manifest-path cua-driver/rust/Cargo.toml \
        --package cua-driver

FROM scratch AS cua-artifact
COPY --from=cua-builder \
    /source/cua-driver/rust/target/release/cua-driver \
    /cua-driver

FROM debian:sid AS sway-builder

ARG SWAY_COMMIT=88869399f421d9180dd8b6ed0b5a1f4a3585d252
ARG WLROOTS_COMMIT=d783533489e1f75d6886c2ab5c5960090ef268f8

RUN apt-get -o Acquire::ForceIPv4=true update && \
    apt-get -o Acquire::ForceIPv4=true install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        glslang-tools \
        hwdata \
        libcairo2-dev \
        libdisplay-info-dev \
        libdrm-dev \
        libegl-dev \
        libevdev-dev \
        libgles-dev \
        libinput-dev \
        libjson-c-dev \
        liblcms2-dev \
        libpango1.0-dev \
        libpcre2-dev \
        libpixman-1-dev \
        libseat-dev \
        libsystemd-dev \
        libudev-dev \
        libvulkan-dev \
        libwayland-dev \
        libwlroots-0.20-dev \
        libxcb-errors-dev \
        libxcb-icccm4-dev \
        libxcb1-dev \
        libxkbcommon-dev \
        meson \
        ninja-build \
        pkg-config \
        wayland-protocols \
        xwayland && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /source

COPY scripts/verify-stock-sway-contract.sh \
    /usr/local/libexec/verify-stock-sway-contract

# Fetch the exact source commits behind the pinned upstream releases. The
# release image receives only installed artifacts and licenses, never these
# source trees or the builder toolchain.
RUN git init wlroots && \
    git -C wlroots remote add origin https://gitlab.freedesktop.org/wlroots/wlroots.git && \
    git -C wlroots fetch --depth 1 origin "$WLROOTS_COMMIT" && \
    git -C wlroots checkout --detach FETCH_HEAD && \
    test "$(git -C wlroots rev-parse HEAD)" = "$WLROOTS_COMMIT" && \
    git init sway && \
    git -C sway remote add origin https://github.com/swaywm/sway.git && \
    git -C sway fetch --depth 1 origin "$SWAY_COMMIT" && \
    git -C sway checkout --detach FETCH_HEAD && \
    test "$(git -C sway rev-parse HEAD)" = "$SWAY_COMMIT" && \
    /usr/local/libexec/verify-stock-sway-contract /source/sway

RUN meson setup wlroots/build wlroots \
        --buildtype=release \
        --prefix=/usr \
        --libdir=lib/x86_64-linux-gnu \
        -Dexamples=false \
        -Dxwayland=enabled \
        -Drenderers=gles2,vulkan \
        -Dallocators=gbm,udmabuf \
        -Dcolor-management=enabled && \
    ninja -C wlroots/build && \
    DESTDIR=/sway-root ninja -C wlroots/build install && \
    ninja -C wlroots/build install && \
    ldconfig && \
    meson setup sway/build sway \
        --buildtype=release \
        --prefix=/usr \
        --libdir=lib/x86_64-linux-gnu \
        -Ddefault-wallpaper=false \
        -Dzsh-completions=false \
        -Dbash-completions=false \
        -Dfish-completions=false \
        -Dswaybar=false \
        -Dswaynag=false \
        -Dtray=disabled \
        -Dgdk-pixbuf=disabled \
        -Dman-pages=disabled && \
    ninja -C sway/build && \
    DESTDIR=/sway-root ninja -C sway/build install && \
    install -d /sway-root/usr/share/doc/wildbuzzard-sway && \
    install -m 0644 sway/LICENSE \
        /sway-root/usr/share/doc/wildbuzzard-sway/LICENSE.sway && \
    install -m 0644 wlroots/LICENSE \
        /sway-root/usr/share/doc/wildbuzzard-sway/LICENSE.wlroots

COPY images/desktop/SWAY_UPSTREAM.toml \
    /sway-root/usr/share/doc/wildbuzzard-sway/UPSTREAM.toml

FROM debian:sid

ARG ELECTRON_VERSION=43.2.0
ARG ELECTRON_SHA256=f77ca6ed67bbc68702b69b56ad499bca6ae090705ade7d04f0ac545e409dec68
ARG CUDA_KEYRING_SHA256=d0d4ef986a44400f9db33c600ef33a985175e7cc63d805a10e1839c7a1e78f5f
ARG CUDA_CUDART_VERSION=13.1.80-1
ARG CUDA_CUBLAS_VERSION=13.2.2.2-1

ENV DEBIAN_FRONTEND=noninteractive

# Stock Sway/wlroots desktop with a private D-Bus/AT-SPI session. The image
# intentionally contains no KWin, Plasma shell, compositor source
# tree, compiler toolchain, or Blender.
RUN apt-get -o Acquire::ForceIPv4=true update && \
    apt-get -o Acquire::ForceIPv4=true install --yes --no-install-recommends \
        at-spi2-core \
        ca-certificates \
        chromium \
        curl \
        dbus \
        dbus-user-session \
        dbus-x11 \
        dolphin \
        ffmpeg \
        firefox-esr \
        fonts-dejavu-core \
        fonts-noto-color-emoji \
        fonts-noto-core \
        fonts-noto-cjk \
        foot \
        grim \
        libgl1 \
        libgl1-mesa-dri \
        libnotify-bin \
        libxi6 \
        libxkbcommon0 \
        mako-notifier \
        mesa-utils \
        mesa-vulkan-drivers \
        openssh-client \
        pavucontrol \
        pipewire \
        pipewire-alsa \
        pipewire-pulse \
        pkexec \
        polkitd \
        python3 \
        python3-pyatspi \
        qt6-wayland \
        slurp \
        sudo \
        libwlroots-0.20 \
        wlr-randr \
        systemd \
        systemd-sysv \
        thunar \
        util-linux \
        vulkan-tools \
        wireplumber \
        wtype \
        x11-apps \
        xdg-desktop-portal \
        xdg-desktop-portal-wlr \
        xwayland && \
    rm -f \
        /usr/share/applications/org.kde.ksecretd.desktop \
        /usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.kwallet.service \
        /usr/share/dbus-1/services/org.kde.kwalletd5.service \
        /usr/share/dbus-1/services/org.kde.kwalletd6.service \
        /usr/share/dbus-1/services/org.kde.secretservicecompat.service \
        /usr/share/xdg-desktop-portal/portals/kwallet.portal && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY --from=sway-builder /sway-root/ /

# The reference machine carries only the CUDA runtime needed by normal guest
# applications. Driver libraries and devices still come from the selected host
# GPU through the launcher's bundled, pinned NVIDIA CDI integration. Do not add
# nvcc or a compiler toolchain to the reference image.
RUN curl --fail --location --retry 3 \
        --output /tmp/cuda-keyring.deb \
        "https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64/cuda-keyring_1.1-1_all.deb" && \
    printf '%s  %s\n' "$CUDA_KEYRING_SHA256" /tmp/cuda-keyring.deb \
        | sha256sum --check - && \
    dpkg --install /tmp/cuda-keyring.deb && \
    apt-get -o Acquire::ForceIPv4=true update && \
    apt-get -o Acquire::ForceIPv4=true install --yes --no-install-recommends \
        "cuda-cudart-13-1=${CUDA_CUDART_VERSION}" \
        "libcublas-13-1=${CUDA_CUBLAS_VERSION}" && \
    rm /tmp/cuda-keyring.deb && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY assets/guest/chromium-flags /etc/chromium.d/wildbuzzard
COPY assets/guest/chromium-master-preferences /etc/chromium/master_preferences
COPY assets/guest/fontconfig-rendering.conf /etc/fonts/conf.d/10-wildbuzzard-rendering.conf
COPY assets/guest/kwalletrc /etc/xdg/kwalletrc
COPY assets/guest/applications/ /usr/local/share/applications/

COPY --from=shell-builder \
    /source/target/release/wildbuzzard-shell \
    /usr/libexec/wildbuzzard-shell

RUN useradd --create-home --uid 1000 --user-group --shell /bin/bash wildbuzzard && \
    install -d -o wildbuzzard -g wildbuzzard -m 0700 \
        /home/wildbuzzard \
        /home/wildbuzzard/.cache \
        /home/wildbuzzard/.config \
        /home/wildbuzzard/.config/sway \
        /home/wildbuzzard/.config/sway/config.d \
        /home/wildbuzzard/.local \
        /home/wildbuzzard/.local/share \
        /home/wildbuzzard/.local/state && \
    printf '%s\n' 'wildbuzzard ALL=(ALL:ALL) NOPASSWD: ALL' \
        >/etc/sudoers.d/90-wildbuzzard && \
    chmod 0440 /etc/sudoers.d/90-wildbuzzard && \
    systemctl mask \
        console-getty.service \
        dev-hugepages.mount \
        getty@.service \
        systemd-logind.service \
        systemd-modules-load.service \
        systemd-remount-fs.service \
        systemd-udevd.service \
        systemd-udevd-control.socket \
        systemd-udevd-kernel.socket

COPY --from=cua-builder \
    /source/cua-driver/rust/target/release/cua-driver \
    /usr/local/bin/cua-driver
COPY third_party/trycua-cua/LICENSE.md \
    /usr/share/doc/wildbuzzard-cua/LICENSE.trycua-cua.md
COPY third_party/trycua-cua/UPSTREAM.toml \
    /usr/share/doc/wildbuzzard-cua/UPSTREAM.toml
COPY third_party/trycua-cua/CHANGES.WILDBUZZARD.md \
    /usr/share/doc/wildbuzzard-cua/CHANGES.WILDBUZZARD.md
RUN chmod 0755 /usr/local/bin/cua-driver

RUN curl --fail --location --retry 3 \
        --output /tmp/electron.zip \
        "https://github.com/electron/electron/releases/download/v${ELECTRON_VERSION}/electron-v${ELECTRON_VERSION}-linux-x64.zip" && \
    printf '%s  %s\n' "$ELECTRON_SHA256" /tmp/electron.zip \
        | sha256sum --check - && \
    install -d /opt/electron && \
    python3 -m zipfile -e /tmp/electron.zip /opt/electron && \
    chmod 0755 /opt/electron/electron && \
    rm /tmp/electron.zip

COPY images/desktop/electron-demo /usr/local/share/wildbuzzard-electron-demo
COPY packaging/wildbuzzard.svg /usr/share/icons/hicolor/scalable/apps/wildbuzzard.svg
RUN install -m 0755 \
        /usr/local/share/wildbuzzard-electron-demo/wildbuzzard-electron-demo \
        /usr/local/bin/wildbuzzard-electron-demo && \
    install -m 0644 \
        /usr/local/share/wildbuzzard-electron-demo/wildbuzzard-electron-demo.desktop \
        /usr/share/applications/wildbuzzard-electron-demo.desktop && \
    systemctl mask \
        sys-kernel-config.mount \
        sys-kernel-debug.mount \
        sys-kernel-tracing.mount

STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd", "--system"]

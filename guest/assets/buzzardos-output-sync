"""Coordinate native output geometry, guest UI scale, and guest keyboard.

The native display owns the physical framebuffer and geometry generation.
This process exposes separate narrow, session-private Settings interfaces. A
SetGuestScale request is forwarded to the native display and confirmed against
stock Sway. A SetGuestKeyboard request is compiled with libxkbcommon and
installed as a managed Sway keymap; neither interface accepts commands.
"""

import ctypes
import ctypes.util
import fcntl
import hashlib
import json
import os
import secrets
import selectors
import socket
import stat
import subprocess
import time
import unicodedata


STATE = "/run/buzzardos-display-state/output-state.json"
STATE_DIRECTORY = os.path.dirname(STATE)
HOST_SCALE_CONTROL = "/run/buzzardos-host/display-scale-host.sock"
XKB_CONFIG_ROOT = "/usr/share/X11/xkb"
XKB_LIBRARY = "/usr/lib/x86_64-linux-gnu/libxkbcommon.so.0"
MAX_MESSAGE_BYTES = 4096
MAX_STATE_BYTES = 1024 * 1024
MAX_KEYMAP_BYTES = 4 * 1024 * 1024
MAX_XKB_LAYOUT_GROUPS = 4
SCALE_PRESETS = {
    "automatic": None,
    "100": 120,
    "125": 150,
    "150": 180,
    "175": 210,
    "200": 240,
}
GEOMETRY_KEYS = {
    "physical_width",
    "physical_height",
    "host_surface_scale_120",
    "guest_ui_scale_120",
    "logical_width",
    "logical_height",
    "geometry_generation",
}
IN_CLOSE_WRITE = 0x00000008
IN_MOVED_TO = 0x00000080
IN_CREATE = 0x00000100
KEYBOARD_KEYS = {"model", "layout", "variant", "options"}
XKB_LIMITS = {
    "model": (1, 64),
    "layout": (1, 256),
    "variant": (0, 256),
    "options": (0, 512),
}
HEX_DIGEST_BYTES = 64
TRANSACTION_TOKEN_BYTES = 32
KEYBOARD_STATES = {"prepared", "committed", "aborted", "unknown"}
JOURNAL_PHASES = {"created", "prepared", "sway_applied", "commit_sent", "committed"}
KEYBOARD_METHODS = {
    "PrepareKeyboardMap",
    "StatusKeyboardMap",
    "CommitKeyboardMap",
    "AbortKeyboardMap",
}
DEFAULT_KEYBOARD = {"model": "pc105", "layout": "us", "variant": "", "options": ""}
_SEALED_KEYMAP_HANDLES = {}


class FatalKeyboardTransaction(SystemExit):
    """Force supervised restart when native transaction state is unknowable."""


class KeyboardPrepareRejected(RuntimeError):
    """A typed host rejection that guarantees Prepare did not take ownership."""


class KeyboardPreparedFailure(RuntimeError):
    """Prepare owns/froze physical input but requires guest rollback and Abort."""


def _plain_integer(value):
    return type(value) is int


def valid_geometry(value):
    if not isinstance(value, dict) or set(value) != GEOMETRY_KEYS:
        return False
    if any(not _plain_integer(value[key]) for key in GEOMETRY_KEYS):
        return False
    if not (
        0 < value["physical_width"] <= 65535
        and 0 < value["physical_height"] <= 65535
        and 0 < value["logical_width"] <= 65535
        and 0 < value["logical_height"] <= 65535
        and 120 <= value["host_surface_scale_120"] <= 960
        and 120 <= value["guest_ui_scale_120"] <= 960
        and value["geometry_generation"] > 0
    ):
        return False
    scale = value["guest_ui_scale_120"]
    return (
        value["logical_width"]
        == max(1, value["physical_width"] * 120 // scale)
        and value["logical_height"]
        == max(1, value["physical_height"] * 120 // scale)
    )


def state_geometry(value):
    return {key: value[key] for key in GEOMETRY_KEYS}


def valid_state(value):
    if (
        not isinstance(value, dict)
        or set(value) != GEOMETRY_KEYS | {"schema"}
        or value.get("schema") != 7
    ):
        return False
    try:
        geometry = state_geometry(value)
    except KeyError:
        return False
    return valid_geometry(geometry)


def read_json_regular(path, limit):
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > limit:
            raise ValueError(f"{path} is not a bounded regular file")
        chunks = []
        remaining = limit + 1
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        data = b"".join(chunks)
        if len(data) > limit:
            raise ValueError(f"{path} exceeds {limit} bytes")
        return json.loads(data)
    finally:
        os.close(descriptor)


def read_state():
    try:
        value = read_json_regular(STATE, MAX_STATE_BYTES)
    except (FileNotFoundError, json.JSONDecodeError, OSError, ValueError):
        return None
    return value if valid_state(value) else None


def _numeric_scale(value):
    return type(value) in (int, float) and value > 0


def sway_outputs():
    result = subprocess.run(
        ["swaymsg", "-t", "get_outputs", "--raw"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode != 0:
        return None
    try:
        outputs = json.loads(result.stdout)
    except (json.JSONDecodeError, UnicodeDecodeError):
        return None
    return outputs if isinstance(outputs, list) else None


def active_sway_outputs(outputs):
    if not isinstance(outputs, list):
        return None
    active = []
    for output in outputs:
        if not isinstance(output, dict) or output.get("active") is not True:
            continue
        identifier = output.get("id")
        name = output.get("name")
        if (
            not _plain_integer(identifier)
            or identifier < 0
            or not isinstance(name, str)
            or not name
            or any(
                not (character.isascii() and (character.isalnum() or character in "_.:-"))
                for character in name
            )
        ):
            return None
        active.append((identifier, name, output))
    active.sort(key=lambda item: item[0])
    if not active or len({item[0] for item in active}) != len(active):
        return None
    return active


def sway_matches(state, outputs=None):
    outputs = sway_outputs() if outputs is None else outputs
    active = active_sway_outputs(outputs)
    if active is None:
        return False
    expected_scale = state["guest_ui_scale_120"] / 120
    for index, (_, _, output) in enumerate(active):
        actual_scale = output.get("scale")
        rect = output.get("rect", {})
        mode = output.get("current_mode", {})
        if not (
            _numeric_scale(actual_scale)
            and abs(float(actual_scale) - expected_scale) < 0.00001
            and rect.get("x") == index * state["logical_width"]
            and rect.get("y") == 0
            and rect.get("width") == state["logical_width"]
            and rect.get("height") == state["logical_height"]
            and mode.get("width") == state["physical_width"]
            and mode.get("height") == state["physical_height"]
        ):
            return False
    return True


def configure_sway(state):
    active = active_sway_outputs(sway_outputs())
    if active is None:
        return False
    scale = state["guest_ui_scale_120"] / 120
    commands = []
    for index, (_, name, _) in enumerate(active):
        commands.append(
            f"output {name} mode {state['physical_width']}x{state['physical_height']} "
            f"scale {scale:.9f} pos {index * state['logical_width']} 0"
        )
    result = subprocess.run(
        ["swaymsg", "--quiet", "; ".join(commands)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def reconcile(state=None):
    state = read_state() if state is None else state
    if state is None or sway_matches(state):
        return state is not None
    return configure_sway(state)


def error_response(code, message, current_state=None):
    error = {"code": code, "message": message}
    if current_state is not None:
        error["current_geometry"] = state_geometry(current_state)
    return {"schema": 1, "ok": False, "error": error}


def valid_request(value):
    return (
        isinstance(value, dict)
        and set(value)
        == {"schema", "method", "preset", "current_geometry_generation"}
        and value.get("schema") == 1
        and value.get("method") == "SetGuestScale"
        and value.get("preset") in SCALE_PRESETS
        and _plain_integer(value.get("current_geometry_generation"))
        and value["current_geometry_generation"] > 0
    )


def valid_xkb_component(name, value):
    if not isinstance(value, str):
        return False
    minimum, maximum = XKB_LIMITS[name]
    try:
        encoded = value.encode("ascii")
    except UnicodeEncodeError:
        return False
    return (
        minimum <= len(encoded) <= maximum
        and all(character.isalnum() or character in "_-+,:." for character in value)
    )


def valid_keyboard(value):
    if (
        not isinstance(value, dict)
        or set(value) != KEYBOARD_KEYS
        or not all(valid_xkb_component(name, value.get(name)) for name in KEYBOARD_KEYS)
    ):
        return False
    layouts = value["layout"].split(",")
    if not 1 <= len(layouts) <= MAX_XKB_LAYOUT_GROUPS or any(
        not group for group in layouts
    ):
        return False
    if value["variant"]:
        variants = value["variant"].split(",")
        if (
            not 1 <= len(variants) <= MAX_XKB_LAYOUT_GROUPS
            or len(variants) > len(layouts)
        ):
            return False
    if value["options"] and any(
        not option for option in value["options"].split(",")
    ):
        return False
    return True


def valid_keyboard_request(value):
    return (
        isinstance(value, dict)
        and set(value) == {"schema", "method", "keyboard"}
        and value.get("schema") == 1
        and value.get("method") == "SetGuestKeyboard"
        and valid_keyboard(value.get("keyboard"))
    )


def valid_host_response(value):
    if not isinstance(value, dict) or value.get("schema") != 1:
        return False
    if value.get("ok") is True:
        return (
            set(value) == {"schema", "ok", "preset", "geometry"}
            and value.get("preset") in SCALE_PRESETS
            and valid_geometry(value.get("geometry"))
        )
    if value.get("ok") is not False or set(value) != {"schema", "ok", "error"}:
        return False
    error = value.get("error")
    if not isinstance(error, dict):
        return False
    allowed = {"code", "message", "current_geometry"}
    if not {"code", "message"}.issubset(error) or not set(error).issubset(allowed):
        return False
    if not isinstance(error["code"], str) or not isinstance(error["message"], str):
        return False
    current = error.get("current_geometry")
    return current is None or valid_geometry(current)


def receive_line(connection, limit=MAX_MESSAGE_BYTES):
    data = bytearray()
    while b"\n" not in data:
        chunk = connection.recv(min(1024, limit + 1 - len(data)))
        if not chunk:
            break
        data.extend(chunk)
        if len(data) > limit:
            raise ValueError(f"request exceeds {limit} bytes")
    line, separator, remainder = bytes(data).partition(b"\n")
    if not separator:
        raise ValueError("request is not newline terminated")
    if remainder.strip():
        raise ValueError("only one request is allowed per connection")
    return json.loads(line)


def send_host_request(request):
    metadata = os.lstat(HOST_SCALE_CONTROL)
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISSOCK(metadata.st_mode):
        raise OSError("native display-scale endpoint is not a socket")
    encoded = json.dumps(request, separators=(",", ":"), sort_keys=True).encode() + b"\n"
    if len(encoded) > MAX_MESSAGE_BYTES:
        raise ValueError("encoded display-scale request is too large")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(5)
        connection.connect(HOST_SCALE_CONTROL)
        connection.sendall(encoded)
        response = receive_line(connection)
    if not valid_host_response(response):
        raise ValueError("native display returned an invalid typed response")
    return response


def wait_for_sway_commit(response, timeout=3):
    geometry = response["geometry"]
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        state = read_state()
        if state is None:
            time.sleep(0.02)
            continue
        generation = state["geometry_generation"]
        if generation != geometry["geometry_generation"]:
            if generation > geometry["geometry_generation"]:
                return error_response(
                    "stale_geometry",
                    "display geometry changed before Sway committed the requested scale",
                    state,
                )
            time.sleep(0.02)
            continue
        if state_geometry(state) != geometry:
            return error_response(
                "runtime_failure",
                "native display published geometry inconsistent with its scale response",
                state,
            )
        if sway_matches(state):
            return response
        if not configure_sway(state):
            return error_response(
                "sway_rejected",
                "Sway rejected the coordinated physical mode and guest UI scale",
                state,
            )
        time.sleep(0.02)
    state = read_state()
    return error_response(
        "apply_timeout",
        "Sway did not confirm the requested guest UI scale before the timeout",
        state,
    )


def apply_request(request):
    current = read_state()
    if current is None:
        return error_response("state_unavailable", "native output geometry is unavailable")
    if request["current_geometry_generation"] != current["geometry_generation"]:
        return error_response(
            "stale_geometry",
            "the request was created for an older output geometry generation",
            current,
        )
    try:
        response = send_host_request(request)
    except (FileNotFoundError, json.JSONDecodeError, OSError, ValueError) as error:
        return error_response(
            "runtime_unavailable", f"native display-scale service failed: {error}", current
        )
    if response["ok"] is False:
        return response
    return wait_for_sway_commit(response)


def handle_client(connection):
    connection.settimeout(2)
    try:
        request = receive_line(connection)
        if not valid_request(request):
            response = error_response(
                "invalid_request",
                "expected schema 1 SetGuestScale with a supported preset and current geometry generation",
                read_state(),
            )
        else:
            response = apply_request(request)
    except (json.JSONDecodeError, OSError, ValueError) as error:
        response = error_response("invalid_request", str(error), read_state())
    encoded = json.dumps(response, separators=(",", ":"), sort_keys=True).encode() + b"\n"
    connection.sendall(encoded)


class XkbRuleNames(ctypes.Structure):
    _fields_ = [
        ("rules", ctypes.c_char_p),
        ("model", ctypes.c_char_p),
        ("layout", ctypes.c_char_p),
        ("variant", ctypes.c_char_p),
        ("options", ctypes.c_char_p),
    ]


def _protected_xkb_root(path=None, require_packaged=True):
    path = XKB_CONFIG_ROOT if path is None else path
    if not isinstance(path, str) or not os.path.isabs(path) or os.path.normpath(path) != path:
        raise RuntimeError("XKB configuration root is not an absolute normalized path")
    resolved = os.path.realpath(path)
    # Debian's distro-owned /usr/share/X11/xkb is currently a symlink to the
    # versioned /usr/share/xkeyboard-config-2 directory.  Accept that exact
    # protected package layout as well as an un-symlinked XKB directory; do
    # not broaden this to arbitrary paths below /usr/share.
    approved = (
        resolved == "/usr/share/X11/xkb"
        or resolved == "/usr/share/xkeyboard-config-2"
        or resolved.startswith("/usr/lib/buzzardos/runtime/")
    )
    if require_packaged and not approved:
        raise RuntimeError("XKB configuration root escaped the approved guest runtime")
    metadata = os.stat(resolved, follow_symlinks=False)
    if not stat.S_ISDIR(metadata.st_mode):
        raise RuntimeError("XKB configuration root is not a directory")
    if metadata.st_uid != 0 or metadata.st_mode & 0o022:
        raise RuntimeError("XKB configuration root is not protected by guest root")
    return resolved


def _protected_xkb_library(path=None, require_packaged=True):
    path = XKB_LIBRARY if path is None else path
    if not isinstance(path, str) or not os.path.isabs(path) or os.path.normpath(path) != path:
        raise RuntimeError("libxkbcommon path is not absolute and normalized")
    resolved = os.path.realpath(path)
    approved = resolved.startswith(
        "/usr/lib/x86_64-linux-gnu/libxkbcommon.so."
    ) or resolved.startswith("/usr/lib/buzzardos/runtime/")
    if require_packaged and not approved:
        raise RuntimeError("libxkbcommon escaped the approved guest runtime")
    metadata = os.stat(resolved, follow_symlinks=False)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0 or metadata.st_mode & 0o022:
        raise RuntimeError("libxkbcommon is not a protected guest-root file")
    return resolved


def compile_keymap(
    keyboard, xkb_root=None, library_path=None, require_packaged=True
):
    if not valid_keyboard(keyboard):
        raise ValueError("requested keyboard settings are not bounded XKB component names")
    root = _protected_xkb_root(xkb_root, require_packaged=require_packaged)
    library_name = (
        _protected_xkb_library(library_path, require_packaged=require_packaged)
        if require_packaged or library_path is not None
        else ctypes.util.find_library("xkbcommon")
    )
    if not library_name:
        raise RuntimeError("libxkbcommon is unavailable")
    library = ctypes.CDLL(library_name)
    library.xkb_context_new.argtypes = [ctypes.c_int]
    library.xkb_context_new.restype = ctypes.c_void_p
    library.xkb_context_unref.argtypes = [ctypes.c_void_p]
    library.xkb_context_unref.restype = None
    library.xkb_context_include_path_append.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
    library.xkb_context_include_path_append.restype = ctypes.c_int
    library.xkb_keymap_new_from_names.argtypes = [
        ctypes.c_void_p,
        ctypes.POINTER(XkbRuleNames),
        ctypes.c_int,
    ]
    library.xkb_keymap_new_from_names.restype = ctypes.c_void_p
    library.xkb_keymap_unref.argtypes = [ctypes.c_void_p]
    library.xkb_keymap_unref.restype = None
    library.xkb_keymap_get_as_string.argtypes = [ctypes.c_void_p, ctypes.c_int]
    library.xkb_keymap_get_as_string.restype = ctypes.c_void_p
    # XKB_CONTEXT_NO_DEFAULT_INCLUDES is deliberately used. Both this compiler
    # and the native host gateway consume the byte-identical packaged rules,
    # models, symbols, and types instead of whatever xkb-data happens to exist
    # in either mutable operating-system view.
    context = library.xkb_context_new(1)
    if not context:
        raise RuntimeError("libxkbcommon could not allocate a context")
    if library.xkb_context_include_path_append(context, os.fsencode(root)) != 1:
        library.xkb_context_unref(context)
        raise RuntimeError("libxkbcommon rejected the protected XKB configuration root")
    encoded = {name: keyboard[name].encode() for name in KEYBOARD_KEYS}
    names = XkbRuleNames(
        b"evdev",
        encoded["model"],
        encoded["layout"],
        encoded["variant"],
        encoded["options"],
    )
    keymap = library.xkb_keymap_new_from_names(context, ctypes.byref(names), 0)
    if not keymap:
        library.xkb_context_unref(context)
        raise ValueError("libxkbcommon rejected the requested keyboard settings")
    pointer = library.xkb_keymap_get_as_string(keymap, 1)
    if not pointer:
        library.xkb_keymap_unref(keymap)
        library.xkb_context_unref(context)
        raise RuntimeError("libxkbcommon could not serialize the compiled keymap")
    try:
        keymap_bytes = ctypes.string_at(pointer)
    finally:
        libc = ctypes.CDLL(ctypes.util.find_library("c") or None)
        libc.free.argtypes = [ctypes.c_void_p]
        libc.free.restype = None
        libc.free(pointer)
        library.xkb_keymap_unref(keymap)
        library.xkb_context_unref(context)
    if not keymap_bytes or len(keymap_bytes) > MAX_KEYMAP_BYTES or b"\x00" in keymap_bytes:
        raise ValueError("compiled XKB keymap is empty or exceeds the managed size limit")
    return keymap_bytes


def keyboard_digest(contents):
    return hashlib.sha256(contents).hexdigest()


def _valid_lower_hex(value, length):
    return (
        isinstance(value, str)
        and len(value) == length
        and all(character in "0123456789abcdef" for character in value)
    )


def managed_keymap_directory():
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime or not os.path.isabs(runtime) or os.path.normpath(runtime) != runtime:
        raise RuntimeError("XDG_RUNTIME_DIR is not an absolute normalized path")
    metadata = os.lstat(runtime)
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise RuntimeError("XDG_RUNTIME_DIR is not a real directory")
    if metadata.st_uid != os.geteuid() or metadata.st_mode & 0o077:
        raise RuntimeError("XDG_RUNTIME_DIR is not private to this session user")
    return runtime


def managed_keymap_path(token, digest):
    if not _valid_lower_hex(token, TRANSACTION_TOKEN_BYTES):
        raise ValueError("keyboard transaction token is malformed")
    if not _valid_lower_hex(digest, HEX_DIGEST_BYTES):
        raise ValueError("keyboard keymap digest is malformed")
    return os.path.join(
        managed_keymap_directory(), f"buzzardos-keyboard-{token}-{digest}.xkb"
    )


def write_managed_keymap(contents, token, digest):
    if keyboard_digest(contents) != digest:
        raise ValueError("compiled keymap does not match its canonical digest")
    target = managed_keymap_path(token, digest)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    created = False
    try:
        descriptor = os.open(target, flags, 0o600)
        created = True
        try:
            offset = 0
            while offset < len(contents):
                offset += os.write(descriptor, contents[offset:])
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        directory = os.open(managed_keymap_directory(), os.O_RDONLY | os.O_CLOEXEC)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except Exception:
        if created:
            try:
                os.unlink(target)
            except FileNotFoundError:
                pass
        raise
    return target


def remove_managed_keymap(path):
    directory = managed_keymap_directory()
    if os.path.dirname(path) != directory or not os.path.basename(path).startswith(
        "buzzardos-keyboard-"
    ):
        raise RuntimeError("refusing to remove a keymap outside the managed runtime")
    try:
        metadata = os.lstat(path)
    except FileNotFoundError:
        return
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
    ):
        raise RuntimeError("refusing to remove an unsafe managed keymap path")
    for key, descriptor in list(_SEALED_KEYMAP_HANDLES.items()):
        if key[0] == path:
            os.close(descriptor)
            del _SEALED_KEYMAP_HANDLES[key]
    os.unlink(path)


def transaction_journal_path():
    return os.path.join(
        managed_keymap_directory(), "buzzardos-keyboard-transaction.json"
    )


def _snapshot_shape_is_valid(value):
    if (
        not isinstance(value, dict)
        or set(value) != {"keyboard", "digest", "token", "path"}
        or not valid_keyboard(value.get("keyboard"))
        or not _valid_lower_hex(value.get("digest"), HEX_DIGEST_BYTES)
        or not _valid_lower_hex(value.get("token"), TRANSACTION_TOKEN_BYTES)
        or not isinstance(value.get("path"), str)
    ):
        return False
    try:
        if value["path"] != managed_keymap_path(value["token"], value["digest"]):
            return False
    except (OSError, RuntimeError, ValueError):
        return False
    return True


def read_keymap_snapshot(value):
    """Read one recovery snapshot through a single no-follow descriptor.

    The user-owned file is durable journal evidence only. It is never passed
    to Sway. A later pathname replacement or chmod therefore cannot change the
    exact bytes returned by this function.
    """
    if not _snapshot_shape_is_valid(value):
        raise ValueError("keyboard snapshot identity is malformed")
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(value["path"], flags)
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != os.geteuid()
            or stat.S_IMODE(before.st_mode) != 0o600
            or before.st_size <= 0
            or before.st_size > MAX_KEYMAP_BYTES
        ):
            raise ValueError("keyboard snapshot is not a bounded owner-only regular file")
        contents = bytearray()
        while len(contents) <= MAX_KEYMAP_BYTES:
            chunk = os.read(
                descriptor, min(65536, MAX_KEYMAP_BYTES + 1 - len(contents))
            )
            if not chunk:
                break
            contents.extend(chunk)
        after = os.fstat(descriptor)
        stable_identity = (
            before.st_dev,
            before.st_ino,
            before.st_size,
            before.st_mtime_ns,
        ) == (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
        )
        if not stable_identity or len(contents) > MAX_KEYMAP_BYTES:
            raise ValueError("keyboard snapshot changed while it was being read")
    finally:
        os.close(descriptor)
    contents = bytes(contents)
    if keyboard_digest(contents) != value["digest"]:
        raise ValueError("keyboard snapshot differs from its canonical digest")
    return contents


def _valid_snapshot(value, verify_file=True):
    if not _snapshot_shape_is_valid(value):
        return False
    if not verify_file:
        return True
    try:
        read_keymap_snapshot(value)
    except (OSError, RuntimeError, ValueError):
        return False
    return True


def sealed_sway_keymap_path(snapshot):
    """Return a stable proc-fd path backed by a permanently sealed memfd."""
    if not _snapshot_shape_is_valid(snapshot):
        raise ValueError("keyboard snapshot identity is malformed")
    key = (snapshot["path"], snapshot["token"], snapshot["digest"])
    existing = _SEALED_KEYMAP_HANDLES.get(key)
    if existing is not None:
        return f"/proc/{os.getpid()}/fd/{existing}"

    contents = read_keymap_snapshot(snapshot)
    descriptor = os.memfd_create(
        "buzzardos-sway-keymap", os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING
    )
    try:
        offset = 0
        while offset < len(contents):
            offset += os.write(descriptor, contents[offset:])
        os.lseek(descriptor, 0, os.SEEK_SET)
        required_seals = (
            fcntl.F_SEAL_SHRINK
            | fcntl.F_SEAL_GROW
            | fcntl.F_SEAL_WRITE
            | fcntl.F_SEAL_SEAL
        )
        fcntl.fcntl(descriptor, fcntl.F_ADD_SEALS, required_seals)
        if fcntl.fcntl(descriptor, fcntl.F_GET_SEALS) & required_seals != required_seals:
            raise RuntimeError("Sway keymap memfd did not retain every required seal")
        if keyboard_digest(os.pread(descriptor, len(contents), 0)) != snapshot["digest"]:
            raise RuntimeError("sealed Sway keymap differs from the journal digest")
    except Exception:
        os.close(descriptor)
        raise
    _SEALED_KEYMAP_HANDLES[key] = descriptor
    return f"/proc/{os.getpid()}/fd/{descriptor}"


def _journal_document(prior, requested, phase):
    if phase not in JOURNAL_PHASES:
        raise ValueError("invalid keyboard journal phase")
    if not _valid_snapshot(prior) or not _valid_snapshot(requested):
        raise ValueError("keyboard transaction journal contains an invalid keymap snapshot")
    return {
        "schema": 1,
        "phase": phase,
        "prior": prior,
        "requested": requested,
    }


def write_transaction_journal(prior, requested, phase):
    target = transaction_journal_path()
    document = _journal_document(prior, requested, phase)
    payload = json.dumps(document, separators=(",", ":"), sort_keys=True).encode() + b"\n"
    if len(payload) > 16384:
        raise ValueError("keyboard transaction journal exceeds its managed size limit")
    try:
        existing = os.lstat(target)
    except FileNotFoundError:
        pass
    else:
        if (
            stat.S_ISLNK(existing.st_mode)
            or not stat.S_ISREG(existing.st_mode)
            or existing.st_uid != os.geteuid()
            or stat.S_IMODE(existing.st_mode) != 0o600
        ):
            raise RuntimeError("refusing to replace an unsafe keyboard transaction journal")
    temporary = f"{target}.new-{os.getpid()}-{secrets.token_hex(8)}"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(temporary, flags, 0o600)
        try:
            offset = 0
            while offset < len(payload):
                offset += os.write(descriptor, payload[offset:])
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.replace(temporary, target)
        directory = os.open(managed_keymap_directory(), os.O_RDONLY | os.O_CLOEXEC)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except Exception:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def read_transaction_journal():
    path = transaction_journal_path()
    try:
        metadata = os.lstat(path)
    except FileNotFoundError:
        return None
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or stat.S_IMODE(metadata.st_mode) != 0o600
    ):
        raise RuntimeError("keyboard transaction journal is not a private regular file")
    value = read_json_regular(path, 16384)
    if (
        not isinstance(value, dict)
        or set(value) != {"schema", "phase", "prior", "requested"}
        or value.get("schema") != 1
        or value.get("phase") not in JOURNAL_PHASES
        or not _valid_snapshot(value.get("prior"))
        or not _valid_snapshot(value.get("requested"))
    ):
        raise RuntimeError("keyboard transaction journal is malformed")
    return value


def clear_transaction_journal():
    path = transaction_journal_path()
    try:
        metadata = os.lstat(path)
    except FileNotFoundError:
        return
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or stat.S_IMODE(metadata.st_mode) != 0o600
    ):
        raise RuntimeError("refusing to remove an unsafe keyboard transaction journal")
    os.unlink(path)
    directory = os.open(managed_keymap_directory(), os.O_RDONLY | os.O_CLOEXEC)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def nested_physical_keyboard():
    result = subprocess.run(
        ["swaymsg", "-t", "get_inputs", "--raw"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError("Sway did not return its input inventory")
    inputs = json.loads(result.stdout)
    if not isinstance(inputs, list):
        raise RuntimeError("Sway returned a malformed input inventory")
    matches = []
    for device in inputs:
        if not isinstance(device, dict) or device.get("type") != "keyboard":
            continue
        if device.get("name") != "wayland-keyboard-buzzardos-seat":
            continue
        identifier = device.get("identifier")
        name = device.get("xkb_active_layout_name")
        if (
            isinstance(identifier, str)
            and identifier
            and len(identifier) <= 256
            and all(character.isalnum() or character in "_-+,:." for character in identifier)
            and isinstance(name, str)
            and name
            and len(name.encode()) <= 256
        ):
            matches.append((identifier, name))
    if len(matches) != 1:
        raise RuntimeError(
            "Sway must expose exactly one nested physical keyboard named "
            "wayland-keyboard-buzzardos-seat"
        )
    return matches[0]


def current_keyboard_layout_name():
    return nested_physical_keyboard()[1]


def apply_sway_keymap(snapshot):
    identifier, _ = nested_physical_keyboard()
    keymap_path = sealed_sway_keymap_path(snapshot)
    # The command contains only a validated identifier from Sway's own input
    # inventory and a stable proc-fd path backed by this process's sealed
    # memfd. The user-owned journal pathname is never exposed to Sway, so a
    # replacement or chmod cannot change what the compositor opens. CUA's
    # separate virtual keyboard keeps its semantic text keymap while human
    # input uses this selection.
    result = subprocess.run(
        ["swaymsg", "--quiet", f"input {identifier} xkb_file {keymap_path}"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError("Sway rejected the compiled keyboard keymap")
    return current_keyboard_layout_name()


def valid_keyboard_host_response(value, method):
    if not isinstance(value, dict) or value.get("schema") != 1:
        return False
    if value.get("ok") is False:
        if set(value) != {"schema", "ok", "method", "error"} or value.get(
            "method"
        ) != method:
            return False
        error = value.get("error")
        return (
            isinstance(error, dict)
            and set(error) == {"code", "message"}
            and isinstance(error.get("code"), str)
            and isinstance(error.get("message"), str)
            and 0 < len(error["code"]) <= 64
            and 0 < len(error["message"]) <= 1024
        )
    if value.get("ok") is not True or value.get("method") != method:
        return False
    required = {"schema", "ok", "method", "state", "active_keymap_sha256"}
    optional = {"pending_token", "pending_keymap_sha256"}
    if not required.issubset(value) or not set(value).issubset(required | optional):
        return False
    pending_present = "pending_token" in value or "pending_keymap_sha256" in value
    if pending_present and not optional.issubset(value):
        return False
    return (
        value.get("state") in KEYBOARD_STATES
        and _valid_lower_hex(value.get("active_keymap_sha256"), HEX_DIGEST_BYTES)
        and (
            not pending_present
            or (
                _valid_lower_hex(value.get("pending_token"), TRANSACTION_TOKEN_BYTES)
                and _valid_lower_hex(
                    value.get("pending_keymap_sha256"), HEX_DIGEST_BYTES
                )
            )
        )
    )


def send_keyboard_host_request(request):
    method = request.get("method") if isinstance(request, dict) else None
    if method not in KEYBOARD_METHODS:
        raise ValueError("unknown keyboard transaction method")
    metadata = os.lstat(HOST_SCALE_CONTROL)
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISSOCK(metadata.st_mode):
        raise OSError("native keyboard transaction endpoint is not a socket")
    encoded = json.dumps(request, separators=(",", ":"), sort_keys=True).encode() + b"\n"
    if len(encoded) > MAX_MESSAGE_BYTES:
        raise ValueError("encoded keyboard transaction request is too large")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(5)
        connection.connect(HOST_SCALE_CONTROL)
        connection.sendall(encoded)
        response = receive_line(connection)
    if not valid_keyboard_host_response(response, method):
        raise ValueError("native display returned an invalid keyboard response")
    return response


def _keyboard_request(method, token, digest=None, keyboard=None):
    if method not in KEYBOARD_METHODS or not _valid_lower_hex(
        token, TRANSACTION_TOKEN_BYTES
    ):
        raise ValueError("invalid keyboard transaction request")
    request = {"schema": 1, "method": method, "token": token}
    if method == "PrepareKeyboardMap":
        if not valid_keyboard(keyboard) or not _valid_lower_hex(
            digest, HEX_DIGEST_BYTES
        ):
            raise ValueError("invalid keyboard prepare request")
        request.update(keyboard)
        request["keymap_sha256"] = digest
    elif method in {"CommitKeyboardMap", "AbortKeyboardMap"}:
        if not _valid_lower_hex(digest, HEX_DIGEST_BYTES):
            raise ValueError("invalid keyboard terminal request")
        request["keymap_sha256"] = digest
    return request


def keyboard_host_status(token):
    return send_keyboard_host_request(_keyboard_request("StatusKeyboardMap", token))


def _host_rejection(response):
    if response.get("ok") is False:
        error = response["error"]
        return f"{error['code']}: {error['message']}"
    return None


def prepare_keyboard_host(token, digest, keyboard):
    request = _keyboard_request(
        "PrepareKeyboardMap", token, digest=digest, keyboard=keyboard
    )
    try:
        response = send_keyboard_host_request(request)
    except (FileNotFoundError, json.JSONDecodeError, OSError, ValueError) as error:
        try:
            response = keyboard_host_status(token)
        except (FileNotFoundError, json.JSONDecodeError, OSError, ValueError) as status_error:
            raise FatalKeyboardTransaction(
                f"keyboard Prepare outcome is unknown: {error}; Status failed: {status_error}"
            ) from status_error
        if response.get("ok") is True and response.get("state") == "unknown":
            try:
                response = send_keyboard_host_request(request)
            except (FileNotFoundError, json.JSONDecodeError, OSError, ValueError) as retry_error:
                raise FatalKeyboardTransaction(
                    f"keyboard Prepare retry outcome is unknown: {retry_error}"
                ) from retry_error
    rejection = _host_rejection(response)
    if rejection:
        code = response["error"]["code"]
        if code == "input_overflow":
            raise KeyboardPreparedFailure(
                f"native keyboard queue overflowed after Prepare: {rejection}"
            )
        if code == "transaction_busy":
            raise FatalKeyboardTransaction(
                f"native keyboard has an unreconciled prepared transaction: {rejection}"
            )
        raise KeyboardPrepareRejected(f"native keyboard prepare was rejected: {rejection}")
    if (
        response.get("state") != "prepared"
        or response.get("pending_token") != token
        or response.get("pending_keymap_sha256") != digest
    ):
        raise FatalKeyboardTransaction(
            "native display did not confirm the prepared keyboard transaction"
        )
    return response


def finish_keyboard_host(method, token, digest):
    expected = "committed" if method == "CommitKeyboardMap" else "aborted"
    request = _keyboard_request(method, token, digest=digest)
    response = None
    try:
        response = send_keyboard_host_request(request)
    except (FileNotFoundError, json.JSONDecodeError, OSError, ValueError):
        pass
    if response is not None and response.get("ok") is True:
        if response.get("state") == expected:
            return response
    # A terminal response may have been lost after the host changed state.
    # Status is authoritative and makes commit/abort safe to retry.
    response = keyboard_host_status(token)
    if response.get("ok") is True and response.get("state") == expected:
        return response
    if response.get("ok") is True and response.get("state") == "prepared":
        response = send_keyboard_host_request(request)
        if response.get("ok") is True and response.get("state") == expected:
            return response
        response = keyboard_host_status(token)
        if response.get("ok") is True and response.get("state") == expected:
            return response
    return response


def _new_keymap(keyboard):
    contents = compile_keymap(keyboard)
    digest = keyboard_digest(contents)
    token = secrets.token_hex(TRANSACTION_TOKEN_BYTES // 2)
    path = write_managed_keymap(contents, token, digest)
    return {
        "keyboard": dict(keyboard),
        "digest": digest,
        "token": token,
        "path": path,
    }


class KeyboardTransactionManager:
    def __init__(self, active):
        self.active = active

    @classmethod
    def bootstrap(cls, desired):
        if not valid_keyboard(desired):
            raise ValueError("persisted keyboard settings are invalid")
        # Normal boot starts from the US map declared in Sway and in the host
        # gateway.  Do not run a cross-distro keymap comparison or recovery
        # test during every machine launch.  A non-default persisted setting
        # is an actual configuration change and is applied once.
        clear_transaction_journal()
        manager = cls(_new_keymap(DEFAULT_KEYBOARD))
        if desired != DEFAULT_KEYBOARD:
            manager.apply(desired)
        return manager

    @classmethod
    def _bootstrap_clean(cls, desired):
        desired_map = _new_keymap(desired)
        default_map = None
        try:
            status = keyboard_host_status(secrets.token_hex(TRANSACTION_TOKEN_BYTES // 2))
            if status.get("ok") is not True:
                raise RuntimeError(f"native keyboard status failed: {_host_rejection(status)}")
            active_digest = status["active_keymap_sha256"]
            if active_digest == desired_map["digest"]:
                # A new Sway starts at its own default even when the persistent
                # host gateway still has a non-US map. Freeze physical input
                # through a same-digest transaction before applying anything
                # to this fresh compositor.
                manager = cls(desired_map)
                requested = _new_keymap(desired)
                manager._apply_prepared_map(requested)
                manager.acknowledge_persisted_commit()
                return manager

            default_map = _new_keymap(DEFAULT_KEYBOARD)
            if active_digest != default_map["digest"]:
                raise RuntimeError(
                    "native keyboard state matches neither persisted settings nor the safe boot keymap"
                )
            manager = cls(default_map)
            # Reuse the already compiled requested snapshot; the apply path
            # seals its verified bytes before startup touches fresh Sway.
            manager._apply_prepared_map(desired_map)
            manager.acknowledge_persisted_commit()
            return manager
        except Exception:
            for keymap in [desired_map, default_map]:
                if keymap is not None:
                    try:
                        remove_managed_keymap(keymap["path"])
                    except (OSError, RuntimeError):
                        pass
            raise

    @classmethod
    def _recover(cls, journal, desired):
        prior = journal["prior"]
        requested = journal["requested"]
        status = keyboard_host_status(requested["token"])
        if status.get("ok") is not True:
            raise RuntimeError(
                f"could not inspect interrupted keyboard transaction: {_host_rejection(status)}"
            )
        state = status["state"]
        active_digest = status["active_keymap_sha256"]

        if state == "prepared":
            if (
                status.get("pending_token") != requested["token"]
                or status.get("pending_keymap_sha256") != requested["digest"]
                or active_digest != prior["digest"]
            ):
                raise RuntimeError("native prepared keyboard state disagrees with the journal")
            # Persisted Settings are still authoritative: the interrupted
            # request never returned success. Restore Sway first, then release
            # the native input queue with Abort.
            apply_sway_keymap(prior)
            aborted = finish_keyboard_host(
                "AbortKeyboardMap", requested["token"], requested["digest"]
            )
            if (
                aborted.get("ok") is not True
                or aborted.get("state") != "aborted"
                or aborted.get("active_keymap_sha256") != prior["digest"]
            ):
                raise RuntimeError("interrupted keyboard transaction did not abort cleanly")
            current, obsolete = prior, requested
            sway_aligned = True
        elif active_digest == prior["digest"] and state in {
            "aborted",
            "unknown",
        }:
            current, obsolete = prior, requested
            sway_aligned = False
        elif active_digest == requested["digest"] and state in {
            "committed",
            "unknown",
        }:
            # A Commit response can be lost. Do not apply to a fresh Sway
            # without freezing physical input: the new full transaction below
            # either reapplies the persisted requested map or returns both
            # sides to the still-authoritative prior setting.
            current, obsolete = requested, prior
            sway_aligned = False
        else:
            raise RuntimeError("interrupted keyboard state matches neither journal snapshot")

        manager = cls(current)

        # A terminal host state for the journal's requested map proves Sway
        # was changed before Commit was sent. When that map is now the
        # persisted setting, its bytes remain correct but the sealed fd owned
        # by the former output-sync process must still be replaced below.
        requested_is_persisted_completion = (
            current is requested
            and current["keyboard"] == desired
            and journal["phase"] in {"sway_applied", "commit_sent", "committed"}
        )
        if sway_aligned and current["keyboard"] == desired:
            clear_transaction_journal()
            if obsolete["path"] != current["path"]:
                try:
                    remove_managed_keymap(obsolete["path"])
                except (OSError, RuntimeError):
                    pass
            return manager

        if requested_is_persisted_completion:
            # Sway parsed the old process's sealed memfd before the crash, but
            # that /proc/<pid>/fd path died with its owner. Reattach the same
            # canonical map through a fresh paired same-digest transaction so
            # Sway never retains a dead pathname for later input reconfigure.
            clear_transaction_journal()
            if obsolete["path"] != current["path"]:
                try:
                    remove_managed_keymap(obsolete["path"])
                except (OSError, RuntimeError):
                    pass
            replacement = _new_keymap(desired)
            manager._apply_prepared_map(replacement)
            manager.acknowledge_persisted_commit()
            return manager

        # A crash after the corrective journal replacement but before
        # Prepare leaves a created transaction whose token is authoritatively
        # unknown to the host. Resume that exact transaction. Recompiling it
        # would only create another crash window and orphan the durable map.
        if (
            state == "unknown"
            and current is prior
            and journal["phase"] == "created"
            and requested["keyboard"] == desired
        ):
            manager._complete_created_map(
                requested, preserve_journal_on_prepare_rejection=True
            )
            manager.acknowledge_persisted_commit()
            return manager

        # The reconciled host map is not the persisted setting, or Sway's map
        # cannot be proven aligned with it. Compile the corrective map first,
        # then atomically replace the interrupted journal with the new
        # transaction. os.replace keeps the old recovery record authoritative
        # until the replacement is durable; no clear-before-Prepare gap exists.
        corrective = _new_keymap(desired)
        try:
            write_transaction_journal(current, corrective, "created")
        except (OSError, RuntimeError, ValueError):
            try:
                remove_managed_keymap(corrective["path"])
            except (OSError, RuntimeError):
                pass
            raise
        retained_paths = {current["path"], corrective["path"]}
        if obsolete["path"] not in retained_paths:
            try:
                remove_managed_keymap(obsolete["path"])
            except (OSError, RuntimeError):
                pass
        manager._complete_created_map(
            corrective, preserve_journal_on_prepare_rejection=True
        )
        manager.acknowledge_persisted_commit()
        return manager

    def acknowledge_persisted_commit(self):
        journal = read_transaction_journal()
        if journal is None or journal["phase"] != "committed":
            return False
        if (
            journal["requested"]["digest"] != self.active["digest"]
            or journal["requested"]["token"] != self.active["token"]
        ):
            raise RuntimeError("completed keyboard journal disagrees with active state")
        preferences = persisted_preferences()
        if preferences is None or preferences["keyboard"] != self.active["keyboard"]:
            return False
        clear_transaction_journal()
        try:
            remove_managed_keymap(journal["prior"]["path"])
        except (OSError, RuntimeError):
            pass
        return True

    def _supersede_completed_journal(self):
        journal = read_transaction_journal()
        if journal is None:
            return
        if (
            journal["phase"] != "committed"
            or journal["requested"]["digest"] != self.active["digest"]
            or journal["requested"]["token"] != self.active["token"]
        ):
            raise RuntimeError("an interrupted keyboard transaction requires recovery")
        clear_transaction_journal()
        try:
            remove_managed_keymap(journal["prior"]["path"])
        except (OSError, RuntimeError):
            pass

    def _restore_before_abort(self, requested, reason):
        try:
            active_name = apply_sway_keymap(self.active)
        except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as rollback_error:
            raise FatalKeyboardTransaction(
                f"{reason}; rollback failed before host abort: {rollback_error}"
            ) from rollback_error
        try:
            abort = finish_keyboard_host(
                "AbortKeyboardMap", requested["token"], requested["digest"]
            )
        except (FileNotFoundError, json.JSONDecodeError, OSError, ValueError) as abort_error:
            raise FatalKeyboardTransaction(
                f"{reason}; native abort outcome is unknown: {abort_error}"
            ) from abort_error
        if (
            abort.get("ok") is not True
            or abort.get("state") != "aborted"
            or abort.get("active_keymap_sha256") != self.active["digest"]
        ):
            raise FatalKeyboardTransaction(
                f"{reason}; guest rollback reached {active_name}, but native abort was not confirmed"
            )
        try:
            clear_transaction_journal()
        except (OSError, RuntimeError, ValueError) as journal_error:
            raise FatalKeyboardTransaction(
                f"{reason}; native abort succeeded but journal cleanup failed: {journal_error}"
            ) from journal_error
        try:
            remove_managed_keymap(requested["path"])
        except (OSError, RuntimeError):
            pass
        raise RuntimeError(f"{reason}; the previous keyboard layout was restored")

    def _record_live_phase(self, requested, phase):
        try:
            write_transaction_journal(self.active, requested, phase)
        except (OSError, RuntimeError, ValueError) as error:
            raise FatalKeyboardTransaction(
                f"keyboard transaction journal failed during {phase}: {error}"
            ) from error

    def _complete_created_map(
        self, requested, preserve_journal_on_prepare_rejection=False
    ):
        """Finish a transaction whose durable created journal already exists."""
        try:
            prepare = prepare_keyboard_host(
                requested["token"], requested["digest"], requested["keyboard"]
            )
        except KeyboardPreparedFailure as error:
            self._restore_before_abort(requested, str(error))
        except KeyboardPrepareRejected:
            if not preserve_journal_on_prepare_rejection:
                clear_transaction_journal()
                remove_managed_keymap(requested["path"])
            raise
        self._record_live_phase(requested, "prepared")
        try:
            active_name = apply_sway_keymap(requested)
        except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
            self._restore_before_abort(requested, f"Sway rejected the requested keyboard: {error}")

        self._record_live_phase(requested, "sway_applied")
        self._record_live_phase(requested, "commit_sent")
        try:
            commit = finish_keyboard_host(
                "CommitKeyboardMap", requested["token"], requested["digest"]
            )
        except (FileNotFoundError, json.JSONDecodeError, OSError, ValueError) as error:
            # Do not guess after both the terminal response and Status are
            # unavailable. The durable commit_sent journal is intentionally
            # retained and SystemExit forces the bounded supervisor to restart
            # this service and reconcile before accepting another request.
            raise FatalKeyboardTransaction(
                f"native keyboard commit outcome is unknown; status reconciliation failed: {error}"
            ) from error
        if (
            commit.get("ok") is True
            and commit.get("active_keymap_sha256") == self.active["digest"]
            and commit.get("state") in {"prepared", "aborted", "unknown"}
        ):
            self._restore_before_abort(
                requested, "native display did not confirm the keyboard commit"
            )
        if (
            commit.get("ok") is not True
            or commit.get("state") != "committed"
            or commit.get("active_keymap_sha256") != requested["digest"]
        ):
            raise FatalKeyboardTransaction(
                "native keyboard commit state is inconsistent; supervised reconciliation is required"
            )

        self._record_live_phase(requested, "committed")
        self.active = requested
        return active_name

    def _apply_prepared_map(self, requested):
        try:
            write_transaction_journal(self.active, requested, "created")
        except (OSError, RuntimeError, ValueError):
            try:
                remove_managed_keymap(requested["path"])
            except (OSError, RuntimeError):
                pass
            raise
        return self._complete_created_map(requested)

    def apply(self, keyboard):
        self._supersede_completed_journal()
        requested = _new_keymap(keyboard)
        try:
            return self._apply_prepared_map(requested)
        except Exception:
            # _restore_before_abort already removes a safely aborted request.
            # A path still present is intentionally retained only when the
            # terminal host outcome is unknown, preserving forensic state and
            # avoiding a mutable/reused keymap name.
            raise


def keyboard_error(code, message):
    return {"schema": 1, "ok": False, "error": {"code": code, "message": message}}


def handle_keyboard_client(connection, manager):
    connection.settimeout(2)
    try:
        request = receive_line(connection)
        if not valid_keyboard_request(request):
            response = keyboard_error(
                "invalid_request",
                "expected schema 1 SetGuestKeyboard with bounded XKB component names",
            )
        else:
            try:
                active_name = manager.apply(request["keyboard"])
                response = {
                    "schema": 1,
                    "ok": True,
                    "keyboard": request["keyboard"],
                    "active_layout_name": active_name,
                }
            except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
                response = keyboard_error("apply_failed", str(error))
    except (json.JSONDecodeError, OSError, ValueError) as error:
        response = keyboard_error("invalid_request", str(error))
    encoded = json.dumps(response, separators=(",", ":"), sort_keys=True).encode() + b"\n"
    connection.sendall(encoded)


def control_socket_path(name="buzzardos-display-scale.sock"):
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime or not os.path.isabs(runtime) or os.path.normpath(runtime) != runtime:
        raise SystemExit("XDG_RUNTIME_DIR is not an absolute normalized path")
    metadata = os.lstat(runtime)
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise SystemExit("XDG_RUNTIME_DIR is not a real directory")
    if metadata.st_uid != os.geteuid():
        raise SystemExit("XDG_RUNTIME_DIR is not owned by this session user")
    return os.path.join(runtime, name)


def control_listener(name="buzzardos-display-scale.sock"):
    path = control_socket_path(name)
    try:
        metadata = os.lstat(path)
    except FileNotFoundError:
        pass
    else:
        if (
            stat.S_ISLNK(metadata.st_mode)
            or not stat.S_ISSOCK(metadata.st_mode)
            or metadata.st_uid != os.geteuid()
        ):
            raise SystemExit(f"refusing to replace unsafe Settings control path {path}")
        os.unlink(path)
    old_mask = os.umask(0o077)
    try:
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        listener.bind(path)
    finally:
        os.umask(old_mask)
    os.chmod(path, 0o600)
    listener.listen(8)
    listener.setblocking(False)
    return listener, path


def settings_path():
    config_home = os.environ.get("XDG_CONFIG_HOME")
    if not config_home:
        home = os.environ.get("HOME")
        if not home:
            return None
        config_home = os.path.join(home, ".config")
    return os.path.join(config_home, "buzzardos", "settings.json")


def _default_preferences():
    return {"preset": "automatic", "keyboard": dict(DEFAULT_KEYBOARD)}


def _valid_background(value):
    if not isinstance(value, dict) or not isinstance(value.get("kind"), str):
        return False
    if value["kind"] in {"dark_plain", "dark_logo", "light_plain", "light_logo"}:
        return set(value) == {"kind"}
    if value["kind"] != "custom_solid" or set(value) != {"kind", "color"}:
        return False
    color = value.get("color")
    return (
        isinstance(color, str)
        and len(color) == 7
        and color.startswith("#")
        and all(character in "0123456789abcdefABCDEF" for character in color[1:])
    )


def _valid_generation(value):
    return _plain_integer(value) and 0 <= value <= 0xFFFFFFFFFFFFFFFF


def _valid_updates(value):
    if not isinstance(value, dict) or set(value) != {"last_notified_plan_generation"}:
        return False
    generation = value["last_notified_plan_generation"]
    return generation is None or (
        isinstance(generation, str)
        and 0 < len(generation.encode()) <= 512
        and not any(unicodedata.category(character) == "Cc" for character in generation)
    )


def _valid_pinned_applications(value):
    return (
        isinstance(value, list)
        and len(value) <= 256
        and len(value) == len(set(value))
        and all(
            isinstance(identifier, str)
            and 0 < len(identifier.encode()) <= 255
            and not any(unicodedata.category(character) == "Cc" for character in identifier)
            for identifier in value
        )
    )


def _valid_common_settings(value, keyboard_required, desktop_appearance=False):
    required = {"schema_version", "generation", "appearance", "display", "updates"}
    if keyboard_required:
        required.add("keyboard")
    if not isinstance(value, dict) or set(value) != required:
        return False
    appearance = value.get("appearance")
    display = value.get("display")
    appearance_keys = {"theme", "background"}
    if desktop_appearance:
        appearance_keys.update({"capped_task_buttons", "pinned_applications"})
    return (
        _valid_generation(value.get("generation"))
        and isinstance(appearance, dict)
        and set(appearance) == appearance_keys
        and appearance.get("theme") in {"dark", "light"}
        and _valid_background(appearance.get("background"))
        and (
            not desktop_appearance
            or (
                type(appearance.get("capped_task_buttons")) is bool
                and _valid_pinned_applications(appearance.get("pinned_applications"))
            )
        )
        and isinstance(display, dict)
        and set(display) == {"guest_ui_scale"}
        and display.get("guest_ui_scale") in SCALE_PRESETS
        and _valid_updates(value.get("updates"))
        and (not keyboard_required or valid_keyboard(value.get("keyboard")))
    )


def persisted_preferences():
    path = settings_path()
    if path is None:
        return None
    try:
        value = read_json_regular(path, MAX_STATE_BYTES)
    except FileNotFoundError:
        return _default_preferences()
    except (json.JSONDecodeError, OSError, ValueError):
        return None
    version = value.get("schema_version") if isinstance(value, dict) else None
    if not _plain_integer(version):
        return None
    if version == 3 and _valid_common_settings(
        value, keyboard_required=True, desktop_appearance=True
    ):
        return {
            "preset": value["display"]["guest_ui_scale"],
            "keyboard": dict(value["keyboard"]),
        }
    if version == 2 and _valid_common_settings(value, keyboard_required=True):
        return {
            "preset": value["display"]["guest_ui_scale"],
            "keyboard": dict(value["keyboard"]),
        }
    if version == 1 and _valid_common_settings(value, keyboard_required=False):
        return {
            "preset": value["display"]["guest_ui_scale"],
            "keyboard": dict(DEFAULT_KEYBOARD),
        }
    if version == 0 and isinstance(value, dict) and set(value) == {
        "schema_version",
        "dark_mode",
        "scale_percent",
    }:
        percent = value.get("scale_percent")
        preset = "automatic" if percent is None else str(percent)
        if type(value.get("dark_mode")) is bool and preset in SCALE_PRESETS:
            return {"preset": preset, "keyboard": dict(DEFAULT_KEYBOARD)}
    return None


def persisted_preset():
    preferences = persisted_preferences()
    return None if preferences is None else preferences["preset"]


def persisted_keyboard():
    preferences = persisted_preferences()
    return None if preferences is None else preferences["keyboard"]


def apply_persisted_scale(preferences=None):
    preferences = persisted_preferences() if preferences is None else preferences
    preset = None if preferences is None else preferences["preset"]
    state = read_state()
    if preset is None or state is None:
        return
    request = {
        "schema": 1,
        "method": "SetGuestScale",
        "preset": preset,
        "current_geometry_generation": state["geometry_generation"],
    }
    # Startup failure remains visible in the service log. Existing native
    # geometry is still reconciled so a corrupt preference cannot blank Sway.
    response = apply_request(request)
    if response.get("ok") is not True:
        print(
            "buzzardos-output-sync: persisted scale was not applied: "
            + response.get("error", {}).get("message", "unknown error"),
            flush=True,
        )


def apply_persisted_keyboard(preferences=None):
    preferences = persisted_preferences() if preferences is None else preferences
    keyboard = None if preferences is None else preferences["keyboard"]
    if keyboard is None:
        raise RuntimeError("the complete persisted Settings document is invalid")
    return KeyboardTransactionManager.bootstrap(keyboard)


def publish_ready():
    _, active_name = nested_physical_keyboard()
    path = control_socket_path("buzzardos-output-sync-ready.json")
    temporary = f"{path}.new-{os.getpid()}"
    payload = json.dumps(
        {"schema": 1, "keyboard_active_layout_name": active_name},
        separators=(",", ":"),
        sort_keys=True,
    ).encode() + b"\n"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(temporary, flags, 0o600)
        try:
            offset = 0
            while offset < len(payload):
                offset += os.write(descriptor, payload[offset:])
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.replace(temporary, path)
    except Exception:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise
    os.chmod(path, 0o600)


def clear_ready():
    path = control_socket_path("buzzardos-output-sync-ready.json")
    try:
        metadata = os.lstat(path)
    except FileNotFoundError:
        return
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
    ):
        raise SystemExit(f"refusing to replace unsafe output-sync readiness path {path}")
    os.unlink(path)


def inotify():
    library_name = ctypes.util.find_library("c")
    if not library_name:
        raise SystemExit("cannot locate libc for inotify")
    library = ctypes.CDLL(library_name, use_errno=True)
    library.inotify_init1.argtypes = [ctypes.c_int]
    library.inotify_init1.restype = ctypes.c_int
    library.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
    library.inotify_add_watch.restype = ctypes.c_int
    descriptor = library.inotify_init1(os.O_CLOEXEC | os.O_NONBLOCK)
    if descriptor < 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))
    watch = library.inotify_add_watch(
        descriptor,
        os.fsencode(STATE_DIRECTORY),
        IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE,
    )
    if watch < 0:
        error = ctypes.get_errno()
        os.close(descriptor)
        raise OSError(error, os.strerror(error), STATE_DIRECTORY)
    return descriptor


def sway_subscription():
    return subprocess.Popen(
        [
            "swaymsg",
            "--raw",
            "--monitor",
            "--type",
            "subscribe",
            '["output","shutdown"]',
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )


def main():
    notify = inotify()
    subscription = sway_subscription()
    if subscription.stdout is None:
        raise SystemExit("cannot subscribe to Sway output events")
    clear_ready()
    scale_listener, scale_listener_path = control_listener("buzzardos-display-scale.sock")
    keyboard_listener, keyboard_listener_path = control_listener(
        "buzzardos-keyboard-settings.sock"
    )
    selector = selectors.DefaultSelector()
    selector.register(notify, selectors.EVENT_READ, "state")
    selector.register(subscription.stdout, selectors.EVENT_READ, "sway")
    selector.register(scale_listener, selectors.EVENT_READ, "scale-control")
    selector.register(keyboard_listener, selectors.EVENT_READ, "keyboard-control")
    preferences = persisted_preferences()
    if preferences is None:
        print(
            "buzzardos-output-sync: complete persisted Settings document is invalid; using safe defaults",
            flush=True,
        )
        preferences = _default_preferences()
    apply_persisted_scale(preferences)
    keyboard_manager = apply_persisted_keyboard(preferences)
    reconcile()
    publish_ready()
    try:
        while True:
            keyboard_manager.acknowledge_persisted_commit()
            for key, _ in selector.select(timeout=0.5):
                if key.data == "state":
                    os.read(notify, 65536)
                    reconcile()
                elif key.data == "sway":
                    event = subscription.stdout.readline()
                    if not event:
                        raise SystemExit("Sway output subscription ended")
                    reconcile()
                elif key.data == "scale-control":
                    connection, _ = scale_listener.accept()
                    with connection:
                        handle_client(connection)
                else:
                    connection, _ = keyboard_listener.accept()
                    with connection:
                        handle_keyboard_client(connection, keyboard_manager)
    finally:
        subscription.terminate()
        subscription.wait(timeout=2)
        scale_listener.close()
        keyboard_listener.close()
        for listener_path in [scale_listener_path, keyboard_listener_path]:
            try:
                os.unlink(listener_path)
            except FileNotFoundError:
                pass
        os.close(notify)


if __name__ == "__main__":
    # Sway exports the private SWAYSOCK to this process. Refuse to operate
    # without it instead of ever discovering or guessing another socket.
    if not os.environ.get("SWAYSOCK"):
        raise SystemExit("SWAYSOCK is not set")
    main()

[Unit]
Description=Commit Wild Buzzard protected-runtime desktop readiness
After=wildbuzzard-desktop.service
Requires=wildbuzzard-desktop.service
ConditionPathIsSymbolicLink=/opt/wildbuzzard/runtime/current

[Service]
Type=oneshot
User=root
Group=root
UMask=0022
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/run/wildbuzzard-host/driver.env
ExecStart=/opt/wildbuzzard/runtime/current/libexec/wildbuzzard-runtime-ready
TimeoutStartSec=120s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target

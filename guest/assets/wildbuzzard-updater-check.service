[Unit]
Description=Ask Buzzard OS to check configured Debian repositories
After=dbus.service network-online.target wildbuzzard-updater.service
Wants=network-online.target wildbuzzard-updater.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/busctl --system call org.openresearchtools.WildBuzzard.Updater1 /org/openresearchtools/WildBuzzard/Updater1 org.openresearchtools.WildBuzzard.Updater1 Check
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX

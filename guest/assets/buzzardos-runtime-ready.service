[Unit]
Description=Commit Buzzard OS protected-runtime desktop readiness
After=buzzardos-desktop.service
Requires=buzzardos-desktop.service
ConditionPathIsSymbolicLink=/opt/buzzardos/runtime/current

[Service]
Type=oneshot
User=root
Group=root
UMask=0022
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/run/buzzardos-host/driver.env
ExecStart=/opt/buzzardos/runtime/current/libexec/buzzardos-runtime-ready
TimeoutStartSec=120s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target

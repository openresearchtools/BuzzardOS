[Unit]
Description=Buzzard OS Sway desktop session
After=dbus.service
Wants=dbus.service

[Service]
Type=simple
User=wildbuzzard
Group=wildbuzzard
WorkingDirectory=/home/wildbuzzard
Environment=HOME=/home/wildbuzzard
Environment=USER=wildbuzzard
Environment=LOGNAME=wildbuzzard
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_CONFIG_DIRS=/etc/wildbuzzard/xdg:/etc/xdg
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=sway
Environment=XDG_SESSION_DESKTOP=sway
Environment=QT_QPA_PLATFORM=wayland;xcb
Environment=QT_QPA_PLATFORMTHEME=gtk3
Environment=QT_ACCESSIBILITY=1
Environment=GTK_MODULES=gail:atk-bridge
Environment=NO_AT_BRIDGE=0
Environment=CUA_DRIVER_RS_ENABLE_WAYLAND=1
Environment=CUA_DRIVER_RS_TELEMETRY_ENABLED=false
Environment=WILDBUZZARD_STATUS_DIR=/run/wildbuzzard-host
EnvironmentFile=/run/wildbuzzard-host/driver.env
ExecStart=/opt/wildbuzzard/runtime/current/libexec/wildbuzzard-session
ExecStopPost=+/opt/wildbuzzard/runtime/current/libexec/wildbuzzard-desktop-stopped
KillMode=mixed
TimeoutStopSec=30
Restart=no

[Install]
WantedBy=multi-user.target

#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

export HOME=/home/user
export USER=user
export LOGNAME=user
export XDG_RUNTIME_DIR=/run/user/1000
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_DATA_DIRS=/usr/share/buzzardos:/usr/local/share:/usr/share
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CONFIG_DIRS=/etc/buzzardos/xdg:/etc/xdg
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export QT_QPA_PLATFORM='wayland;xcb'
export QT_QPA_PLATFORMTHEME=gtk3
export QT_ACCESSIBILITY=1
export GTK_MODULES="${GTK_MODULES:+$GTK_MODULES:}gail:atk-bridge"
export NO_AT_BRIDGE=0
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export XKB_CONFIG_ROOT=/usr/share/X11/xkb
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

export WAYLAND_DISPLAY=/run/buzzardos-host/wayland-0
unset WAYLAND_SOCKET
unset DISPLAY

# Use the conventional per-user bus location. The bus is still entirely
# private to the guest because /run is a fresh tmpfs and no host D-Bus socket
# enters the mount namespace. A stable address also lets agents, terminals,
# and services started after login discover the normal session bus without
# scraping another process's environment.
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
rm -f "$XDG_RUNTIME_DIR/bus"
dbus-daemon \
    --session \
    --address="$DBUS_SESSION_BUS_ADDRESS" \
    --nofork \
    --nopidfile \
    --nosyslog &
dbus_pid=$!

attempt=0
while [ "$attempt" -lt 100 ] && [ ! -S "$XDG_RUNTIME_DIR/bus" ]; do
    if ! kill -0 "$dbus_pid" 2>/dev/null; then
        wait "$dbus_pid"
        exit $?
    fi
    attempt=$((attempt + 1))
    sleep 0.01
done
if [ ! -S "$XDG_RUNTIME_DIR/bus" ]; then
    echo "private session D-Bus did not create $XDG_RUNTIME_DIR/bus" >&2
    kill "$dbus_pid" 2>/dev/null || true
    wait "$dbus_pid" 2>/dev/null || true
    exit 1
fi

# The shell loads ~/.config/buzzardos/settings.json before publishing
# readiness, atomically projects the selected mode to toolkit/application
# configuration, and updates GSettings. Do not force a mode here: doing so
# would overwrite the user's persisted Light selection on every Stop/Start.

/usr/lib/buzzardos/runtime/current/libexec/buzzardos-sway-session &
session_pid=$!

cleanup() {
    kill "$session_pid" "$dbus_pid" 2>/dev/null || true
    wait "$session_pid" 2>/dev/null || true
    wait "$dbus_pid" 2>/dev/null || true
    rm -f "$XDG_RUNTIME_DIR/bus"
}
trap cleanup EXIT INT TERM HUP

set +e
wait "$session_pid"
status=$?
set -e
exit "$status"

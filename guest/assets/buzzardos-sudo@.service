[Unit]
Description=Buzzard OS guest sudo handoff

[Service]
Type=exec
ExecStart=/usr/lib/buzzardos/runtime/current/libexec/buzzardos-sudo-exec --serve
User=root
Group=root
UMask=0077
StandardInput=socket
StandardOutput=socket
StandardError=null
KillMode=mixed
TimeoutStartSec=infinity
TimeoutStopSec=30s

"""Bind the active protected runtime to an observed ready desktop session."""

from __future__ import annotations

import hashlib
import json
import os
import re
import stat
import tempfile
import time
from pathlib import Path


RUNTIME_ROOT = Path("/opt/buzzardos/runtime")
DESKTOP_READY = Path("/run/buzzardos-host/desktop-ready")
REVISION_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+~-]{0,127}$")
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
MAX_MANIFEST_BYTES = 1024 * 1024
MAX_FILES = 4096
MAX_ENTRIES = MAX_FILES * 2 + 32
MAX_FILE_BYTES = 512 * 1024 * 1024
MAX_READY_BYTES = 256
SESSION_TOKEN_RE = re.compile(r"^[0-9a-f]{32}$")
HOST_RUNTIME_UID = 1000
HOST_RUNTIME_GID = 1000
HOST_RUNTIME_MODE = 0o700
REQUIRED_RUNTIME_FILES = {
    "libexec/buzzardos-shell",
    "libexec/buzzardos-settings",
    "libexec/buzzardos-shortcut-helper",
    "libexec/buzzardos-clipboard-agent",
    "libexec/buzzardos-updater",
}


class ReadinessError(RuntimeError):
    pass


def secure_directory(
    path: Path, expected_uid: int = 0, expected_gid: int = 0
) -> os.stat_result:
    metadata = path.lstat()
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise ReadinessError(f"protected runtime directory is unsafe: {path}")
    if metadata.st_uid != expected_uid or metadata.st_gid != expected_gid:
        raise ReadinessError(f"protected runtime directory is not guest-root owned: {path}")
    if metadata.st_mode & 0o022:
        raise ReadinessError(f"protected runtime directory is group/world writable: {path}")
    return metadata


def _open_flags() -> int:
    return os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | getattr(os, "O_NONBLOCK", 0)


def _same_file(before: os.stat_result, after: os.stat_result) -> bool:
    return (
        before.st_dev,
        before.st_ino,
        before.st_size,
        before.st_mtime_ns,
        before.st_ctime_ns,
    ) == (
        after.st_dev,
        after.st_ino,
        after.st_size,
        after.st_mtime_ns,
        after.st_ctime_ns,
    )


def _reject_duplicate_keys(pairs: list[tuple[str, object]]) -> dict[str, object]:
    value: dict[str, object] = {}
    for key, item in pairs:
        if key in value:
            raise ReadinessError(f"protected runtime JSON contains duplicate key: {key}")
        value[key] = item
    return value


def read_json(
    path: Path, expected_uid: int = 0, expected_gid: int = 0
) -> object:
    descriptor = os.open(path, _open_flags())
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_size > MAX_MANIFEST_BYTES
            or stat.S_IMODE(metadata.st_mode) != 0o644
        ):
            raise ReadinessError(f"protected runtime metadata is unsafe: {path}")
        if metadata.st_uid != expected_uid or metadata.st_gid != expected_gid:
            raise ReadinessError(f"protected runtime metadata permissions are unsafe: {path}")
        remaining = metadata.st_size
        chunks: list[bytes] = []
        while remaining:
            chunk = os.read(descriptor, min(remaining, 64 * 1024))
            if not chunk:
                raise ReadinessError(f"protected runtime metadata changed while reading: {path}")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise ReadinessError(f"protected runtime metadata grew while reading: {path}")
        if not _same_file(metadata, os.fstat(descriptor)):
            raise ReadinessError(f"protected runtime metadata changed while reading: {path}")
    finally:
        os.close(descriptor)
    return json.loads(b"".join(chunks), object_pairs_hook=_reject_duplicate_keys)


def hash_regular(
    path: Path,
    maximum: int,
    expected_uid: int = 0,
    expected_gid: int = 0,
) -> tuple[str, os.stat_result]:
    descriptor = os.open(path, _open_flags())
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_size > maximum
        ):
            raise ReadinessError(f"protected runtime file is unsafe: {path}")
        if (
            metadata.st_uid != expected_uid
            or metadata.st_gid != expected_gid
            or metadata.st_mode & 0o022
        ):
            raise ReadinessError(f"protected runtime file permissions are unsafe: {path}")
        digest = hashlib.sha256()
        remaining = metadata.st_size
        while remaining:
            chunk = os.read(descriptor, min(remaining, 1024 * 1024))
            if not chunk:
                raise ReadinessError(f"protected runtime file changed while hashing: {path}")
            digest.update(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise ReadinessError(f"protected runtime file grew while hashing: {path}")
        if not _same_file(metadata, os.fstat(descriptor)):
            raise ReadinessError(f"protected runtime file changed while hashing: {path}")
        return digest.hexdigest(), metadata
    finally:
        os.close(descriptor)


def validate_component_chain(
    revision_dir: Path,
    relative: str,
    expected_uid: int = 0,
    expected_gid: int = 0,
) -> Path:
    components = relative.split("/")
    if (
        not relative
        or relative.startswith("/")
        or any(component in {"", ".", ".."} for component in components)
    ):
        raise ReadinessError("protected runtime manifest contains an unsafe path")
    parent = revision_dir
    for component in components[:-1]:
        parent = parent / component
        secure_directory(parent, expected_uid, expected_gid)
    return parent / components[-1]


def validated_manifest(
    revision: str,
    revision_dir: Path,
    expected_uid: int = 0,
    expected_gid: int = 0,
) -> tuple[bytes, dict[str, object]]:
    manifest = read_json(
        revision_dir / "runtime.manifest.json", expected_uid, expected_gid
    )
    if not isinstance(manifest, dict) or set(manifest) != {
        "schema_version",
        "revision",
        "files",
    }:
        raise ReadinessError("protected runtime manifest has unexpected fields")
    if (
        isinstance(manifest["schema_version"], bool)
        or manifest["schema_version"] != 1
        or manifest["revision"] != revision
    ):
        raise ReadinessError("protected runtime manifest revision/schema mismatch")
    files = manifest["files"]
    if not isinstance(files, dict) or not files or len(files) > MAX_FILES:
        raise ReadinessError("protected runtime manifest inventory is invalid")
    if not REQUIRED_RUNTIME_FILES.issubset(files):
        raise ReadinessError("protected runtime manifest is missing required executables")
    seen: set[str] = set()
    pending = [(revision_dir, Path())]
    entry_count = 0
    while pending:
        directory, relative_directory = pending.pop()
        with os.scandir(directory) as entries:
            for entry in entries:
                entry_count += 1
                if entry_count > MAX_ENTRIES:
                    raise ReadinessError("protected runtime tree has too many entries")
                relative = relative_directory / entry.name
                relative_text = relative.as_posix()
                metadata = entry.stat(follow_symlinks=False)
                if stat.S_ISLNK(metadata.st_mode):
                    raise ReadinessError(
                        f"protected runtime contains a symbolic link: {relative_text}"
                    )
                if (
                    metadata.st_uid != expected_uid
                    or metadata.st_gid != expected_gid
                    or metadata.st_mode & 0o022
                ):
                    raise ReadinessError(
                        f"protected runtime path permissions are unsafe: {relative_text}"
                    )
                if stat.S_ISDIR(metadata.st_mode):
                    pending.append((Path(entry.path), relative))
                elif stat.S_ISREG(metadata.st_mode):
                    if relative_text not in {"runtime.manifest.json", "readiness.json"}:
                        seen.add(relative_text)
                else:
                    raise ReadinessError(
                        f"protected runtime contains a special file: {relative_text}"
                    )
    if seen != set(files):
        raise ReadinessError("protected runtime file inventory differs from its manifest")
    for relative, record in sorted(files.items()):
        if (
            not isinstance(relative, str)
            or not isinstance(record, dict)
            or set(record) != {"sha256", "mode"}
            or not isinstance(record["sha256"], str)
            or SHA256_RE.fullmatch(record["sha256"]) is None
            or not isinstance(record["mode"], int)
            or isinstance(record["mode"], bool)
            or not 0 <= record["mode"] <= 0o777
        ):
            raise ReadinessError("protected runtime manifest contains an unsafe record")
        candidate = validate_component_chain(
            revision_dir, relative, expected_uid, expected_gid
        )
        digest, metadata = hash_regular(
            candidate, MAX_FILE_BYTES, expected_uid, expected_gid
        )
        if stat.S_IMODE(metadata.st_mode) != record["mode"] or digest != record["sha256"]:
            raise ReadinessError(f"protected runtime file differs from manifest: {relative}")
    canonical = json.dumps(
        manifest, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode()
    return canonical, manifest


def read_desktop_ready(
    path: Path,
    expected_token: str,
    expected_uid: int = 1000,
    expected_gid: int = 1000,
    parent_uid: int = HOST_RUNTIME_UID,
    parent_gid: int = HOST_RUNTIME_GID,
) -> None:
    if SESSION_TOKEN_RE.fullmatch(expected_token) is None:
        raise ReadinessError("desktop session token is invalid")
    parent = path.parent
    parent_metadata = parent.lstat()
    if (
        stat.S_ISLNK(parent_metadata.st_mode)
        or not stat.S_ISDIR(parent_metadata.st_mode)
        or parent_metadata.st_uid != parent_uid
        or parent_metadata.st_gid != parent_gid
        or stat.S_IMODE(parent_metadata.st_mode) != HOST_RUNTIME_MODE
    ):
        raise ReadinessError("desktop readiness directory is unsafe")
    descriptor = os.open(path, _open_flags())
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != expected_uid
            or metadata.st_gid != expected_gid
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_size > MAX_READY_BYTES
        ):
            raise ReadinessError("desktop readiness evidence is unsafe")
        remaining = metadata.st_size
        chunks: list[bytes] = []
        while remaining:
            chunk = os.read(descriptor, remaining)
            if not chunk:
                raise ReadinessError("desktop readiness evidence changed while reading")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1) or not _same_file(metadata, os.fstat(descriptor)):
            raise ReadinessError("desktop readiness evidence changed while reading")
    finally:
        os.close(descriptor)
    payload = b"".join(chunks)
    if payload != f"{expected_token}\n".encode("ascii"):
        raise ReadinessError("desktop readiness evidence is from another session")


def atomic_write(path: Path, payload: bytes) -> None:
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o644)
        remaining = memoryview(payload)
        while remaining:
            written = os.write(descriptor, remaining)
            if written <= 0:
                raise ReadinessError("could not write protected runtime readiness")
            remaining = remaining[written:]
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def main() -> int:
    session_token = os.environ.get("BUZZARDOS_SESSION_TOKEN", "")
    if SESSION_TOKEN_RE.fullmatch(session_token) is None:
        raise ReadinessError("desktop session token is missing or invalid")
    deadline = time.monotonic() + 110.0
    while True:
        try:
            read_desktop_ready(DESKTOP_READY, session_token)
            break
        except FileNotFoundError:
            if time.monotonic() >= deadline:
                raise ReadinessError(
                    "desktop did not publish readiness before the runtime deadline"
                ) from None
            time.sleep(0.1)

    secure_directory(RUNTIME_ROOT)
    current = RUNTIME_ROOT / "current"
    current_metadata = current.lstat()
    if (
        not stat.S_ISLNK(current_metadata.st_mode)
        or current_metadata.st_uid != 0
        or current_metadata.st_gid != 0
    ):
        raise ReadinessError("protected runtime current is not a guest-root-owned symbolic link")
    revision = os.readlink(current)
    if REVISION_RE.fullmatch(revision) is None:
        raise ReadinessError("protected runtime current target is invalid")
    revision_dir = RUNTIME_ROOT / revision
    revision_metadata = secure_directory(revision_dir)
    canonical, _manifest = validated_manifest(revision, revision_dir)
    current_after = current.lstat()
    revision_after = revision_dir.lstat()
    if (
        current_after.st_dev != current_metadata.st_dev
        or current_after.st_ino != current_metadata.st_ino
        or os.readlink(current) != revision
        or revision_after.st_dev != revision_metadata.st_dev
        or revision_after.st_ino != revision_metadata.st_ino
    ):
        raise ReadinessError("protected runtime activation changed during validation")
    readiness = {
        "schema_version": 1,
        "revision": revision,
        "manifest_sha256": hashlib.sha256(canonical).hexdigest(),
        "ready": True,
    }
    payload = json.dumps(
        readiness, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode() + b"\n"
    atomic_write(revision_dir / "readiness.json", payload)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

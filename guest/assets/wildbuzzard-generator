#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

normal_dir=$1
wants_dir="$normal_dir/multi-user.target.wants"
mkdir -p "$wants_dir"
ln -sf /usr/lib/systemd/system/wildbuzzard-desktop.service \
    "$wants_dir/wildbuzzard-desktop.service"
ln -sf /usr/lib/systemd/system/wildbuzzard-runtime-ready.service \
    "$wants_dir/wildbuzzard-runtime-ready.service"
ln -sf /usr/lib/systemd/system/wildbuzzard-updater.service \
    "$wants_dir/wildbuzzard-updater.service"

timer_wants="$1/timers.target.wants"
mkdir -p "$timer_wants"
ln -sf /usr/lib/systemd/system/wildbuzzard-updater.timer \
    "$timer_wants/wildbuzzard-updater.timer"

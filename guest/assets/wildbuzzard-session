#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

export HOME=/home/wildbuzzard
export USER=wildbuzzard
export LOGNAME=wildbuzzard
export XDG_RUNTIME_DIR=/run/user/1000
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CONFIG_DIRS=/etc/wildbuzzard/xdg:/etc/xdg
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export QT_QPA_PLATFORM='wayland;xcb'
export QT_QPA_PLATFORMTHEME=gtk3
export QT_ACCESSIBILITY=1
export GTK_MODULES="${GTK_MODULES:+$GTK_MODULES:}gail:atk-bridge"
export NO_AT_BRIDGE=0
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export CUA_DRIVER_RS_ENABLE_WAYLAND=1

install -d -m 0700 \
    "$XDG_RUNTIME_DIR" \
    "$XDG_CONFIG_HOME" \
    "$XDG_CONFIG_HOME/gtk-3.0" \
    "$XDG_DATA_HOME" \
    "$XDG_CACHE_HOME" \
    "$XDG_STATE_HOME"

# Seed Thunar's standard GTK bookmark as the interactive user. Existing
# bookmarks and labels are preserved, and later launches never duplicate the
# /shared entry.
bookmarks="$XDG_CONFIG_HOME/gtk-3.0/bookmarks"
if [ ! -e "$bookmarks" ]; then
    install -m 0600 /dev/null "$bookmarks"
fi
if [ -f "$bookmarks" ]; then
    bookmark_tmp=$(mktemp "$XDG_CONFIG_HOME/gtk-3.0/.bookmarks.wildbuzzard.XXXXXX")
    awk '
        $1 == "file:///shared" {
            if (!shared) {
                print "file:///shared Shared"
                shared = 1
            }
            next
        }
        { print }
        END {
            if (!shared)
                print "file:///shared Shared"
        }
    ' "$bookmarks" >"$bookmark_tmp"
    chmod 0600 "$bookmark_tmp"
    if cmp -s "$bookmarks" "$bookmark_tmp"; then
        rm -f "$bookmark_tmp"
    else
        mv -f "$bookmark_tmp" "$bookmarks"
    fi
fi

export WAYLAND_DISPLAY=/run/wildbuzzard-host/wayland-0
unset WAYLAND_SOCKET
unset DISPLAY

# Use the conventional per-user bus location. The bus is still entirely
# private to the guest because /run is a fresh tmpfs and no host D-Bus socket
# enters the mount namespace. A stable address also lets agents, terminals,
# and services started after login discover the normal session bus without
# scraping another process's environment.
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
rm -f "$XDG_RUNTIME_DIR/bus"
dbus-daemon \
    --session \
    --address="$DBUS_SESSION_BUS_ADDRESS" \
    --nofork \
    --nopidfile \
    --nosyslog &
dbus_pid=$!

attempt=0
while [ "$attempt" -lt 100 ] && [ ! -S "$XDG_RUNTIME_DIR/bus" ]; do
    if ! kill -0 "$dbus_pid" 2>/dev/null; then
        wait "$dbus_pid"
        exit $?
    fi
    attempt=$((attempt + 1))
    sleep 0.01
done
if [ ! -S "$XDG_RUNTIME_DIR/bus" ]; then
    echo "private session D-Bus did not create $XDG_RUNTIME_DIR/bus" >&2
    kill "$dbus_pid" 2>/dev/null || true
    wait "$dbus_pid" 2>/dev/null || true
    exit 1
fi

# GTK's desktop-interface GSettings have higher precedence than the system
# settings.ini files. Keep the reference session's persistent user settings
# aligned with the selected Wild Buzzard widget and icon themes so applications
# do not silently fall back to Adwaita after dconf has been initialized.
gsettings set org.gnome.desktop.interface gtk-theme WildBuzzard
gsettings set org.gnome.desktop.interface icon-theme WildBuzzard
gsettings set org.gnome.desktop.interface color-scheme prefer-dark

/usr/libexec/wildbuzzard-sway-session &
session_pid=$!

cleanup() {
    kill "$session_pid" "$dbus_pid" 2>/dev/null || true
    wait "$session_pid" 2>/dev/null || true
    wait "$dbus_pid" 2>/dev/null || true
    rm -f "$XDG_RUNTIME_DIR/bus"
}
trap cleanup EXIT INT TERM HUP

set +e
wait "$session_pid"
status=$?
set -e
exit "$status"

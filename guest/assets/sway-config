# Buzzard OS exposes one classic stacking desktop plus numbered, guest-private
# CUA workspaces. The native Rust shell owns the desktop, thin workspace bar,
# Applications menu, and bottom taskbar through layer-shell; Sway owns guest
# application placement, focus, outputs, seats, resize, and decorations.
set $mod Mod4
font pango:DejaVu Sans 10
floating_modifier $mod normal
focus_follows_mouse no
focus_wrapping no
workspace_auto_back_and_forth no
default_border normal 8
default_floating_border normal 8
hide_edge_borders none
titlebar_border_thickness 2
# Keep the top application titlebar comfortably tall while the left, right,
# and bottom resize borders remain compact.
titlebar_padding 6 7
show_marks no

output * scale_filter nearest

# Graphite decorations with a restrained Ubuntu-style orange active accent.
client.focused #30343a #30343a #f2f2f2 #ff7139 #30343a
client.focused_inactive #24272a #24272a #b8b8b8 #545454 #24272a
client.unfocused #24272a #24272a #a5a5a5 #545454 #24272a
client.urgent #9b2c2c #9b2c2c #ffffff #f07a7a #9b2c2c
client.placeholder #282828 #282828 #b8b8b8 #545454 #282828
client.background #181818

# buzzardos-output-sync installs the persisted, validated XKB keymap after
# Sway creates the private nested keyboard. Sway's safe default is used only
# until that session-private service confirms the managed map.

# This is a classic floating desktop, not Sway's default tiling UI. `[all]`
# is stock Sway's creation-time catch-all for managed xdg-shell and Xwayland
# toplevels; layer-shell desktop/panel surfaces are not views and do not match.
# Applying the normal border in the same command gives every application
# Sway's synchronized titlebar, drag path, and four-edge/four-corner resize.
for_window [all] floating enable, border normal 8

# Stock Sway scopes an unqualified mouse binding to the titlebar. Run after
# button release so the compositor's implicit grab has ended before the shell
# maps its transient menu surface; the surface then receives an ordinary
# pointer-enter coordinate without any global click record. Application
# content keeps button 3.
bindsym --release button3 focus, exec --no-startup-id /usr/bin/buzzardos-desktop --request-focused-window-menu

# Conventional guest shortcuts. There is deliberately no compositor root menu,
# workspace bar, launcher, or host lifecycle action in this configuration.
bindsym $mod+Return exec foot
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

workspace Desktop
exec_always --no-startup-id /opt/buzzardos/runtime/current/libexec/buzzardos-desktop-services

include /run/buzzardos-host/initial-output.conf
include /home/buzzard/.config/sway/config.d/*

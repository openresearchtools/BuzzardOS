# Wild Buzzard exposes one classic stacking desktop. The native Rust shell
# owns the desktop, Applications menu, and bottom taskbar through layer-shell;
# Sway owns guest application placement, focus, resize, and decorations.
set $mod Mod4
font pango:DejaVu Sans 10
floating_modifier $mod normal
focus_follows_mouse no
focus_wrapping no
workspace_auto_back_and_forth no
default_border normal 8
default_floating_border normal 8
hide_edge_borders none
titlebar_border_thickness 2
# Keep the top application titlebar comfortably tall while the left, right,
# and bottom resize borders remain compact.
titlebar_padding 6 7
show_marks no

output * scale_filter nearest

# Graphite decorations with a restrained Ubuntu-style orange active accent.
client.focused #30343a #30343a #f2f2f2 #ff7139 #30343a
client.focused_inactive #24272a #24272a #b8b8b8 #545454 #24272a
client.unfocused #24272a #24272a #a5a5a5 #545454 #24272a
client.urgent #9b2c2c #9b2c2c #ffffff #f07a7a #9b2c2c
client.placeholder #282828 #282828 #b8b8b8 #545454 #282828
client.background #181818

input * {
    xkb_layout us
}

# This is a classic floating desktop, not Sway's default tiling UI. `[all]`
# is stock Sway's creation-time catch-all for managed xdg-shell and Xwayland
# toplevels; layer-shell desktop/panel surfaces are not views and do not match.
# Applying the normal border in the same command gives every application
# Sway's synchronized titlebar, drag path, and four-edge/four-corner resize.
for_window [all] floating enable, border normal 8

# Stock Sway scopes an unqualified mouse binding to the titlebar. Focus the
# exact container under the pointer, then ask the shell to open its normal
# accessible window-controls menu. Application content keeps button 3.
bindsym button3 focus, exec --no-startup-id /usr/libexec/wildbuzzard-shell --request-focused-window-menu

# Conventional guest shortcuts. There is deliberately no compositor root menu,
# workspace bar, launcher, or host lifecycle action in this configuration.
bindsym $mod+Return exec foot
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

workspace 1
exec_always --no-startup-id /usr/libexec/wildbuzzard-desktop-services

include /run/wildbuzzard-host/initial-output.conf
include /home/wildbuzzard/.config/sway/config.d/*

WORKDIR /source

COPY oci/verify-stock-sway-contract.sh \
    /usr/local/libexec/verify-stock-sway-contract

# Fetch the exact source commits behind the pinned upstream releases. The
# release image receives only installed artifacts and licenses, never these
# source trees or the builder toolchain.
RUN git init wlroots && \
    git -C wlroots remote add origin https://gitlab.freedesktop.org/wlroots/wlroots.git && \
    git -C wlroots fetch --depth 1 origin "$WLROOTS_COMMIT" && \
    git -C wlroots checkout --detach FETCH_HEAD && \
    test "$(git -C wlroots rev-parse HEAD)" = "$WLROOTS_COMMIT" && \
    git init sway && \
    git -C sway remote add origin https://github.com/swaywm/sway.git && \
    git -C sway fetch --depth 1 origin "$SWAY_COMMIT" && \
    git -C sway checkout --detach FETCH_HEAD && \
    test "$(git -C sway rev-parse HEAD)" = "$SWAY_COMMIT" && \
    /usr/local/libexec/verify-stock-sway-contract /source/sway

RUN runtime_prefix=/opt/wildbuzzard/runtime/payload && \
    meson setup wlroots/build wlroots \
        --buildtype=release \
        --prefix="$runtime_prefix" \
        --libdir=lib \
        -Dexamples=false \
        -Dxwayland=enabled \
        -Drenderers=gles2,vulkan \
        -Dallocators=gbm,udmabuf \
        -Dcolor-management=enabled && \
    ninja -C wlroots/build && \
    DESTDIR=/sway-root ninja -C wlroots/build install && \
    ninja -C wlroots/build install && \
    PKG_CONFIG_PATH="$runtime_prefix/lib/pkgconfig" \
    LD_LIBRARY_PATH="$runtime_prefix/lib" \
    meson setup sway/build sway \
        --buildtype=release \
        --prefix="$runtime_prefix" \
        --libdir=lib \
        -Dc_link_args='-Wl,-rpath,$ORIGIN/../lib' \
        -Ddefault-wallpaper=false \
        -Dzsh-completions=false \
        -Dbash-completions=false \
        -Dfish-completions=false \
        -Dswaybar=false \
        -Dswaynag=false \
        -Dtray=disabled \
        -Dgdk-pixbuf=disabled \
        -Dman-pages=disabled && \
    ninja -C sway/build && \
    DESTDIR=/sway-root ninja -C sway/build install && \
    install -d /sway-licenses && \
    install -m 0644 sway/LICENSE \
        /sway-licenses/LICENSE.sway && \
    install -m 0644 wlroots/LICENSE \
        /sway-licenses/LICENSE.wlroots && \
    rm -rf \
        "/sway-root$runtime_prefix/include" \
        "/sway-root$runtime_prefix/lib/pkgconfig" \
        "/sway-root$runtime_prefix/share" && \
    find "/sway-root$runtime_prefix" -type f \
        \( -name '*.a' -o -name '*.la' \) -delete && \
    find "/sway-root$runtime_prefix" -type l -print | while IFS= read -r link; do \
        resolved=$(readlink -f -- "$link") && \
        test -f "$resolved" && \
        replacement="$link.wildbuzzard-real" && \
        cp -pL -- "$link" "$replacement" && \
        mv -f -- "$replacement" "$link"; \
    done && \
    ! find "/sway-root$runtime_prefix" -type l -print -quit | grep -q . && \
    readelf -d "/sway-root$runtime_prefix/bin/sway" | \
        grep -Fq '$ORIGIN/../lib' && \
    readelf -d "/sway-root$runtime_prefix/bin/swaymsg" | \
        grep -Fq '$ORIGIN/../lib' && \
    install -d /runtime-payload && \
    cp -a "/sway-root$runtime_prefix/." /runtime-payload/ && \
    xkb_library=$(readlink -f /usr/lib/x86_64-linux-gnu/libxkbcommon.so.0) && \
    test -f "$xkb_library" && \
    test ! -L "$xkb_library" && \
    readelf -d "$xkb_library" | grep -Fq 'Library soname: [libxkbcommon.so.0]' && \
    install -D -m 0755 "$xkb_library" \
        /runtime-payload/lib/libxkbcommon.so.0 && \
    xkb_entry=/usr/share/X11/xkb && \
    xkb_source=$(readlink -f -- "$xkb_entry") && \
    case "$xkb_source" in \
        /usr/share/X11/xkb|/usr/share/xkeyboard-config-[0-9]*) ;; \
        *) echo "xkb-data package root resolves outside its expected location: $xkb_source" >&2; exit 1 ;; \
    esac && \
    xkb_destination=/runtime-payload/share/X11/xkb && \
    test -d "$xkb_source" && \
    test ! -L "$xkb_source" && \
    find "$xkb_source" -type l -print | while IFS= read -r link; do \
        resolved=$(readlink -f -- "$link") && \
        case "$resolved" in \
            "$xkb_source"/*) ;; \
            *) echo "xkb-data symlink escapes its package tree: $link" >&2; exit 1 ;; \
        esac && \
        test -f "$resolved"; \
    done && \
    install -d "$(dirname -- "$xkb_destination")" && \
    cp -aL "$xkb_source" "$xkb_destination" && \
    ! find "$xkb_destination" -type l -print -quit | grep -q . && \
    ! find "$xkb_destination" -mindepth 1 ! -type d ! -type f -print -quit | grep -q . && \
    install -d \
        /runtime-payload/share/doc/libxkbcommon0 \
        /runtime-payload/share/doc/xkb-data \
        /runtime-payload/share/wildbuzzard && \
    install -m 0644 /usr/share/doc/libxkbcommon0/copyright \
        /runtime-payload/share/doc/libxkbcommon0/copyright && \
    install -m 0644 /usr/share/doc/xkb-data/copyright \
        /runtime-payload/share/doc/xkb-data/copyright && \
    xkb_library_version=$(dpkg-query -W -f='${Version}' libxkbcommon0) && \
    xkb_version=$(dpkg-query -W -f='${Version}' xkb-data) && \
    case "$xkb_library_version" in \
        ''|*[!A-Za-z0-9.+:~_-]*) echo "invalid libxkbcommon0 version: $xkb_library_version" >&2; exit 1 ;; \
    esac && \
    case "$xkb_version" in \
        ''|*[!A-Za-z0-9.+:~_-]*) echo "invalid xkb-data version: $xkb_version" >&2; exit 1 ;; \
    esac && \
    printf '%s\n' "$xkb_library_version" \
        >/runtime-payload/share/wildbuzzard/libxkbcommon0.version && \
    sha256sum /runtime-payload/lib/libxkbcommon.so.0 | \
        sed 's#  /runtime-payload/#  #' \
        >/runtime-payload/share/wildbuzzard/libxkbcommon0.manifest.sha256 && \
    printf '%s\n' "$xkb_version" \
        >/runtime-payload/share/wildbuzzard/xkb-data.version && \
    ( \
        cd "$xkb_destination" && \
        LC_ALL=C find . -type f -printf '%P\n' | LC_ALL=C sort | \
            while IFS= read -r relative; do \
                case "$relative" in \
                    ''|/*|*..*|*[!A-Za-z0-9._+/@~-]*) \
                        echo "unsafe xkb-data path: $relative" >&2; exit 1 ;; \
                esac && \
                digest=$(sha256sum -- "$relative" | cut -d' ' -f1) && \
                printf '%s  %s\n' "$digest" "$relative"; \
            done \
    ) >/runtime-payload/share/wildbuzzard/xkb-data.manifest.sha256 && \
    test -s /runtime-payload/share/wildbuzzard/xkb-data.manifest.sha256 && \
    test -s /runtime-payload/share/wildbuzzard/libxkbcommon0.manifest.sha256 && \
    (cd /runtime-payload && \
        sha256sum --check share/wildbuzzard/libxkbcommon0.manifest.sha256)

COPY oci/desktop/SWAY_UPSTREAM.toml \
    /sway-licenses/UPSTREAM.toml

FROM scratch AS sway-runtime-artifact
COPY --from=sway-builder /runtime-payload/ /


RUN cargo clippy \
        --locked \
        --release \
        --manifest-path guest/Cargo.toml \
        --package wildbuzzard-settings \
        --package wildbuzzard-shortcut-helper \
        --all-targets \
        -- -D warnings && \
    cargo test \
        --locked \
        --release \
        --manifest-path guest/Cargo.toml \
        --package wildbuzzard-settings \
        --package wildbuzzard-shortcut-helper && \
    cargo build \
        --locked \
        --release \
        --manifest-path guest/Cargo.toml \
        --package wildbuzzard-settings \
        --package wildbuzzard-shortcut-helper


FROM docker.io/library/rust:1.96-slim@sha256:d8f0d5c09580253ecdd6d6894ff112b2b760683ff2a74585e5189f2578728ce4 AS shell-builder

COPY oci/desktop/apt/debian-trixie-snapshot.sources \
    /etc/apt/sources.list.d/debian.sources
COPY oci/desktop/apt/99wildbuzzard-snapshot \
    /etc/apt/apt.conf.d/99wildbuzzard-snapshot

RUN apt-get -o Acquire::ForceIPv4=true update && \
    apt-get -o Acquire::ForceIPv4=true install --yes --no-install-recommends \
        libglib2.0-dev \
        libxkbcommon-dev \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /source
COPY clipboard-protocol ./clipboard-protocol
COPY guest/Cargo.toml guest/Cargo.lock ./guest/
COPY guest/clipboard-agent ./guest/clipboard-agent
COPY guest/desktop-core ./guest/desktop-core
COPY guest/settings ./guest/settings
COPY guest/shell ./guest/shell
COPY guest/shortcut-helper ./guest/shortcut-helper
RUN cargo build \
        --locked \
        --release \
        --manifest-path guest/Cargo.toml \
        --package wildbuzzard-shell \
        --package wildbuzzard-clipboard-agent && \
    install -D -m 0644 \
        "$(rustc --print sysroot)/share/doc/rust/COPYRIGHT-library.html" \
        /rust-notices/COPYRIGHT-library.html

FROM docker.io/library/rust:1.96-slim@sha256:d8f0d5c09580253ecdd6d6894ff112b2b760683ff2a74585e5189f2578728ce4 AS settings-builder

COPY oci/desktop/apt/debian-trixie-snapshot.sources \
    /etc/apt/sources.list.d/debian.sources
COPY oci/desktop/apt/99wildbuzzard-snapshot \
    /etc/apt/apt.conf.d/99wildbuzzard-snapshot

RUN apt-get -o Acquire::ForceIPv4=true update && \
    apt-get -o Acquire::ForceIPv4=true install --yes --no-install-recommends \
        libgtk-4-dev \
        libpulse-dev \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

RUN rustup component add clippy

WORKDIR /source
COPY clipboard-protocol ./clipboard-protocol
COPY guest/Cargo.toml guest/Cargo.lock ./guest/

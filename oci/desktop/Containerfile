FROM docker.io/library/debian:sid@sha256:900a6f89c05e3f3323f274eb9ce3bb2d35695fac097360dfc6f1cfe2e921996b AS sway-builder

COPY oci/desktop/apt/debian-sid-snapshot.sources \
    /etc/apt/sources.list.d/debian.sources
COPY oci/desktop/apt/99wildbuzzard-snapshot \
    /etc/apt/apt.conf.d/99wildbuzzard-snapshot

ARG SWAY_COMMIT=88869399f421d9180dd8b6ed0b5a1f4a3585d252
ARG WLROOTS_COMMIT=d783533489e1f75d6886c2ab5c5960090ef268f8

RUN apt-get -o Acquire::ForceIPv4=true update && \
    apt-get -o Acquire::ForceIPv4=true install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        glslang-tools \
        hwdata \
        libcairo2-dev \
        libdisplay-info-dev \
        libdrm-dev \
        libegl-dev \
        libevdev-dev \
        libgles-dev \
        libinput-dev \

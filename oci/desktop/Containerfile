        /source/cua-driver \
        /source/runtime-payload

FROM docker.io/library/debian:sid@sha256:900a6f89c05e3f3323f274eb9ce3bb2d35695fac097360dfc6f1cfe2e921996b

ARG CUDA_CUDART_VERSION=13.1.80-1

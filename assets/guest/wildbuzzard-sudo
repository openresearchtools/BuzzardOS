#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

# Bubblewrap deliberately keeps the persistent rootfs nosuid and nodev. That
# prevents a mutable guest filesystem from turning setuid bits or device nodes
# into a host attack surface, but also means the distribution sudo binary
# cannot elevate. Delegate elevation to the guest's own systemd PID 1 instead.
# The matching private polkit rule grants this only to the interactive guest
# user; systemd and polkit are both inside the machine namespaces.

if [ "$(id -u)" -eq 0 ]; then
    exec /usr/bin/sudo "$@"
fi
if [ "$(id -u)" -ne 1000 ]; then
    echo "sudo: only the Wild Buzzard interactive user has passwordless guest root" >&2
    exit 1
fi

target_user=0
target_group=0
environment_assignments=

while [ "$#" -gt 0 ]; do
    case "$1" in
        --)
            shift
            break
            ;;
        -n|--non-interactive|-H|--set-home|-S|--stdin)
            shift
            ;;
        -E|--preserve-env)
            shift
            ;;
        -u|--user)
            [ "$#" -ge 2 ] || {
                echo "sudo: $1 requires a user" >&2
                exit 2
            }
            target_user=$2
            shift 2
            ;;
        -g|--group)
            [ "$#" -ge 2 ] || {
                echo "sudo: $1 requires a group" >&2
                exit 2
            }
            target_group=$2
            shift 2
            ;;
        -v|--validate)
            exit 0
            ;;
        -k|-K|--reset-timestamp|--remove-timestamp)
            shift
            ;;
        -*)
            echo "sudo: unsupported guest option: $1" >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

while [ "$#" -gt 0 ]; do
    case "$1" in
        [A-Za-z_][A-Za-z0-9_]*=*)
            environment_assignments="$environment_assignments
$1"
            shift
            ;;
        *)
            break
            ;;
    esac
done

[ "$#" -gt 0 ] || {
    echo "sudo: a command is required" >&2
    exit 2
}

runtime_dir=${XDG_RUNTIME_DIR:-/run/user/1000}
sudo_runtime=$(mktemp -d "$runtime_dir/wildbuzzard-sudo.XXXXXX")
output_fifo=$sudo_runtime/output
mkfifo -m 0600 "$output_fifo"
cat "$output_fifo" &
output_reader=$!

cleanup() {
    kill "$output_reader" 2>/dev/null || true
    wait "$output_reader" 2>/dev/null || true
    rm -f "$output_fifo"
    rmdir "$sudo_runtime" 2>/dev/null || true
}
trap cleanup EXIT INT TERM HUP

if [ -n "$environment_assignments" ]; then
    # Word splitting is intentional only for newline-delimited assignments
    # validated above. Original user command arguments remain "$@".
    old_ifs=$IFS
    IFS='
'
    # shellcheck disable=SC2086
    set -- /usr/bin/env $environment_assignments "$@"
    IFS=$old_ifs
fi

set +e
systemd-run \
    --system \
    --wait \
    --quiet \
    --collect \
    --service-type=exec \
    --uid="$target_user" \
    --gid="$target_group" \
    --working-directory="${PWD:-/}" \
    /usr/libexec/wildbuzzard-sudo-exec \
    "$output_fifo" \
    -- \
    "$@"
status=$?
set -e

wait "$output_reader"
trap - EXIT INT TERM HUP
rm -f "$output_fifo"
rmdir "$sudo_runtime"
exit "$status"

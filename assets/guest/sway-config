# Wild Buzzard exposes one classic stacking desktop. The native Rust shell
# owns the desktop, Applications menu, and bottom taskbar through layer-shell;
# Sway owns guest application placement, focus, resize, and decorations.
set $mod Mod4
font pango:DejaVu Sans 10
floating_modifier $mod normal
focus_follows_mouse yes
focus_wrapping no
workspace_auto_back_and_forth no
default_border normal 3
default_floating_border normal 3
hide_edge_borders none
titlebar_border_thickness 2
titlebar_padding 6 4

output * bg #1d435b solid_color

input * {
    xkb_layout us
}

# This is a classic floating desktop, not Sway's default tiling UI. Layer-shell
# surfaces from the Wild Buzzard shell are unaffected by these view rules.
for_window [shell="xdg_shell"] floating enable
for_window [shell="xwayland"] floating enable

# Conventional guest shortcuts. There is deliberately no compositor root menu,
# workspace bar, launcher, or host lifecycle action in this configuration.
bindsym $mod+Return exec foot
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

workspace 1
exec_always --no-startup-id /usr/libexec/wildbuzzard-desktop-services

include /run/wildbuzzard-host/initial-output.conf
include /home/wildbuzzard/.config/sway/config.d/*

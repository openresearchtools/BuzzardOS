"""Keep stock Sway's nested output native at the host's fractional scale."""

import json
import os
import selectors
import subprocess
import ctypes
import ctypes.util


STATE = "/run/wildbuzzard-display-state/output-state.json"
STATE_DIRECTORY = os.path.dirname(STATE)
IN_CLOSE_WRITE = 0x00000008
IN_MOVED_TO = 0x00000080
IN_CREATE = 0x00000100


def valid_state(value):
    required = (
        "scale_120",
        "logical_width",
        "logical_height",
        "physical_width",
        "physical_height",
    )
    if not isinstance(value, dict) or any(
        not isinstance(value.get(key), int) for key in required
    ):
        return False
    return (
        120 <= value["scale_120"] <= 960
        and 0 < value["logical_width"] <= 65535
        and 0 < value["logical_height"] <= 65535
        and 0 < value["physical_width"] <= 131070
        and 0 < value["physical_height"] <= 131070
    )


def sway_matches(state):
    result = subprocess.run(
        ["swaymsg", "-t", "get_outputs", "--raw"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode != 0:
        return False
    try:
        outputs = json.loads(result.stdout)
    except json.JSONDecodeError:
        return False
    expected_scale = state["scale_120"] / 120
    return any(
        output.get("active") is True
        and abs(float(output.get("scale", 0)) - expected_scale) < 0.0001
        and output.get("rect", {}).get("width") == state["logical_width"]
        and output.get("rect", {}).get("height") == state["logical_height"]
        and output.get("current_mode", {}).get("width") == state["physical_width"]
        and output.get("current_mode", {}).get("height") == state["physical_height"]
        for output in outputs
    )


def read_state():
    try:
        with open(STATE, "r", encoding="utf-8") as stream:
            value = json.load(stream)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None
    return value if valid_state(value) else None


def reconcile():
    state = read_state()
    if state is None or sway_matches(state):
        return
    scale = state["scale_120"] / 120
    command = (
        f"output * mode {state['physical_width']}x"
        f"{state['physical_height']} scale {scale:.6f}"
    )
    subprocess.run(
        ["swaymsg", "--quiet", command],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def inotify():
    library_name = ctypes.util.find_library("c")
    if not library_name:
        raise SystemExit("cannot locate libc for inotify")
    library = ctypes.CDLL(library_name, use_errno=True)
    library.inotify_init1.argtypes = [ctypes.c_int]
    library.inotify_init1.restype = ctypes.c_int
    library.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
    library.inotify_add_watch.restype = ctypes.c_int
    descriptor = library.inotify_init1(os.O_CLOEXEC | os.O_NONBLOCK)
    if descriptor < 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))
    watch = library.inotify_add_watch(
        descriptor,
        os.fsencode(STATE_DIRECTORY),
        IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE,
    )
    if watch < 0:
        error = ctypes.get_errno()
        os.close(descriptor)
        raise OSError(error, os.strerror(error), STATE_DIRECTORY)
    return descriptor


def sway_subscription():
    return subprocess.Popen(
        [
            "swaymsg",
            "--raw",
            "--monitor",
            "--type",
            "subscribe",
            '["output","shutdown"]',
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )


def main():
    notify = inotify()
    subscription = sway_subscription()
    if subscription.stdout is None:
        raise SystemExit("cannot subscribe to Sway output events")
    selector = selectors.DefaultSelector()
    selector.register(notify, selectors.EVENT_READ, "state")
    selector.register(subscription.stdout, selectors.EVENT_READ, "sway")
    reconcile()
    try:
        while True:
            for key, _ in selector.select():
                if key.data == "state":
                    os.read(notify, 65536)
                else:
                    event = subscription.stdout.readline()
                    if not event:
                        raise SystemExit("Sway output subscription ended")
                reconcile()
    finally:
        subscription.terminate()
        subscription.wait(timeout=2)
        os.close(notify)


if __name__ == "__main__":
    # Sway exports the private SWAYSOCK to this process. Refuse to operate
    # without it instead of ever discovering or guessing another socket.
    if not os.environ.get("SWAYSOCK"):
        raise SystemExit("SWAYSOCK is not set")
    main()

# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Ubuntu 24.04 and newer mediate unprivileged user-namespace creation through
# AppArmor.  Keep the exception attached to Buzzard's two exact installed
# entry points; do not grant user namespaces to the system-wide unshare or
# Bubblewrap programs.

abi <abi/4.0>,

include <tunables/global>

profile buzzardos /usr/bin/buzzardos flags=(attach_disconnected,mediate_deleted) {
  # This is an exact-path user-namespace compatibility profile, not a source
  # of host privilege.  DAC, the invoking uid, subordinate-id authorization,
  # no_new_privs, nosuid mounts, seccomp, and the kernel's namespace rules
  # remain authoritative.  The broad allow set prevents AppArmor 5 from
  # silently stacking Ubuntu's generic unprivileged_userns profile, which
  # removes the namespace capabilities required by guest systemd.
  capability,
  file rwlkm /{**,},
  network,
  unix,
  ptrace,
  signal,
  mqueue,
  io_uring,
  userns,
  mount,
  umount,
  pivot_root,
  dbus,

  /{**,} ix,

  include if exists <local/usr.bin.buzzardos>
}

profile buzzardos-broker /usr/libexec/buzzardos/buzzardos-broker flags=(attach_disconnected,mediate_deleted) {
  capability,
  file rwlkm /{**,},
  network,
  unix,
  ptrace,
  signal,
  mqueue,
  io_uring,
  userns,
  mount,
  umount,
  pivot_root,
  dbus,

  /{**,} ix,

  include if exists <local/usr.libexec.buzzardos.buzzardos-broker>
}

#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

fail() {
    printf 'Buzzard OS host dependency setup: %s\n' "$*" >&2
    exit 1
}

if [ "$(uname -s)" != Linux ]; then
    fail "Buzzard OS requires a Linux host"
fi
if ! command -v apt-get >/dev/null 2>&1; then
    fail "automatic installation currently supports Debian and Ubuntu. Install the uidmap package, then rerun ./Install-Dependencies."
fi

if [ "$(id -u)" -eq 0 ]; then
    fail "run this installer as the desktop user, not through sudo"
elif command -v sudo >/dev/null 2>&1; then
    sudo apt-get update
    sudo apt-get install --yes --no-install-recommends uidmap
else
    fail "sudo is unavailable. As an administrator install the uidmap package."
fi

for helper in newuidmap newgidmap; do
    path=$(command -v "$helper" 2>/dev/null || true)
    [ -n "$path" ] || fail "$helper is still unavailable after installing uidmap"
    owner_mode=$(stat -c '%u:%a' -- "$path")
    case "$owner_mode" in
        0:4[0-7][0-7][0-7]|0:6[0-7][0-7][0-7]) ;;
        *) fail "$path must be root-owned and setuid so the kernel can authorize subordinate IDs (found $owner_mode)" ;;
    esac
done

account=$(id -un)
uid=$(id -u)
gid=$(id -g)
find_range() {
    file=$1
    awk -F: -v account="$account" -v uid="$uid" \
        '($1 == account || $1 == uid) && $3 >= 65536 { print $2 ":" $3; exit }' \
        "$file"
}

uid_range=$(find_range /etc/subuid)
gid_range=$(find_range /etc/subgid)
[ -n "$uid_range" ] || fail "no subordinate UID range of at least 65536 IDs exists for $account in /etc/subuid"
[ -n "$gid_range" ] || fail "no subordinate GID range of at least 65536 IDs exists for $account in /etc/subgid"
subuid_start=${uid_range%%:*}
subgid_start=${gid_range%%:*}
case "$subuid_start:$subgid_start:$uid:$gid" in
    *[!0-9:]*) fail "subordinate-ID configuration is not numeric" ;;
esac
if [ "$uid" -ge "$subuid_start" ] && [ "$uid" -lt $((subuid_start + 65536)) ]; then
    fail "the subordinate UID range overlaps the desktop user's host UID"
fi
if [ "$gid" -ge "$subgid_start" ] && [ "$gid" -lt $((subgid_start + 65536)) ]; then
    fail "the subordinate GID range overlaps the desktop user's host GID"
fi

portable_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
unshare="$portable_dir/app/usr/libexec/buzzardos/unshare"
[ -x "$unshare" ] || fail "the bundled namespace helper is missing: $unshare"

# Ubuntu enables a global AppArmor gate for unprivileged user namespaces. Do
# not weaken that policy. Authorize only this extracted folder's bundled
# unshare executable, using a path-derived profile name so relocation requires
# an explicit rerun of this installer.
apparmor_userns_gate=/proc/sys/kernel/apparmor_restrict_unprivileged_userns
if [ -r "$apparmor_userns_gate" ] && [ "$(cat "$apparmor_userns_gate")" = 1 ]; then
    command -v apparmor_parser >/dev/null 2>&1 || \
        fail "AppArmor restricts unprivileged user namespaces, but apparmor_parser is unavailable. Install the distro apparmor package, then rerun this installer."
    profile_digest=$(printf '%s' "$unshare" | sha256sum | awk '{print substr($1, 1, 16)}')
    case "$profile_digest" in
        *[!0-9a-f]*|'') fail "could not derive the AppArmor profile name" ;;
    esac
    profile_name="buzzardos-$uid-$profile_digest"
    profile_path="/etc/apparmor.d/$profile_name"
    escaped_unshare=$(printf '%s\n' "$unshare" | sed \
        -e 's/\\/\\\\/g' \
        -e 's/"/\\"/g' \
        -e 's/\*/\\*/g' \
        -e 's/?/\\?/g' \
        -e 's/\[/\\[/g' \
        -e 's/\]/\\]/g' \
        -e 's/{/\\{/g' \
        -e 's/}/\\}/g' \
        -e 's/\^/\\^/g')
    profile_stage=$(mktemp "${TMPDIR:-/tmp}/buzzardos-apparmor.XXXXXX") || \
        fail "could not create the temporary AppArmor profile"
    trap 'rm -f -- "$profile_stage"' EXIT HUP INT TERM
    {
        printf '%s\n' 'abi <abi/4.0>,' 'include <tunables/global>' ''
        printf 'profile %s "%s" flags=(unconfined) {\n' \
            "$profile_name" "$escaped_unshare"
        printf '%s\n' '  userns,' '}'
    } >"$profile_stage"
    sudo install -o root -g root -m 0644 "$profile_stage" "$profile_path"
    sudo apparmor_parser -r "$profile_path" || \
        fail "AppArmor rejected the exact-path Buzzard OS user-namespace profile $profile_path"
    rm -f -- "$profile_stage"
    trap - EXIT HUP INT TERM
fi

helper_path=$(dirname -- "$(command -v newuidmap)")
[ "$(dirname -- "$(command -v newgidmap)")" = "$helper_path" ] || \
    fail "newuidmap and newgidmap must be installed in the same trusted system directory"
env PATH="$helper_path" "$unshare" \
    --user \
    --map-users "0:$subuid_start:65536" \
    --map-user 1000 \
    --map-groups "0:$subgid_start:65536" \
    --map-group 1000 \
    --setuid 0 --setgid 0 -- /bin/true ||
    fail "the kernel or host security policy rejected Buzzard OS's rootless UID/GID namespace"

[ -n "${XDG_RUNTIME_DIR:-}" ] || fail "XDG_RUNTIME_DIR is missing; run from the logged-in desktop session"
[ -n "${WAYLAND_DISPLAY:-}" ] || fail "WAYLAND_DISPLAY is missing; a host Wayland session is required"
case "$WAYLAND_DISPLAY" in
    /*) wayland_socket=$WAYLAND_DISPLAY ;;
    *) wayland_socket=$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY ;;
esac
[ -S "$wayland_socket" ] || fail "the host Wayland socket is unavailable: $wayland_socket"
[ "$(stat -c %u -- "$wayland_socket")" -eq "$uid" ] || \
    fail "the host Wayland socket is not owned by the desktop user"

printf 'Buzzard OS host dependencies are ready for %s.\n' "$account"

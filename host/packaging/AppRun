#!/bin/sh
set -eu

appdir=${APPDIR:-}
if [ -z "$appdir" ]; then
    case $0 in
        */*) appdir_parent=${0%/*} ;;
        *) appdir_parent=. ;;
    esac
    appdir_parent=${appdir_parent:-/}
    appdir=$(CDPATH= cd -- "$appdir_parent" && pwd)
fi
export PATH="$appdir/usr/bin${PATH:+:$PATH}"
export LD_LIBRARY_PATH="$appdir/usr/lib:$appdir/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$appdir/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
# Mesa's EGL vendor library is host GPU userspace and may be newer than the
# portable build environment. Load the host session's matching Wayland client
# first when one is present so that a newer Mesa never binds to the older
# fallback client carried by the portable application. The bundled client
# remains the dependency-complete fallback on hosts without a standard
# multiarch Wayland library.
host_wayland_client=
for candidate in \
    /usr/lib/x86_64-linux-gnu/libwayland-client.so.0 \
    /lib/x86_64-linux-gnu/libwayland-client.so.0; do
    if [ -r "$candidate" ]; then
        host_wayland_client=$candidate
        break
    fi
done
if [ -n "$host_wayland_client" ]; then
    export LD_PRELOAD="$host_wayland_client${LD_PRELOAD:+:$LD_PRELOAD}"
fi
# Release media pipelines may load only the audited plugins shipped in this
# portable application. In particular, an inherited host plugin path must not substitute a
# lookalike `pulsesrc` or introduce the unbundled direct-ALSA capture plugin.
unset GST_PLUGIN_PATH GST_PLUGIN_PATH_1_0 GST_PLUGIN_SYSTEM_PATH GST_REGISTRY GST_PLUGIN_FEATURE_RANK
export GST_PLUGIN_SYSTEM_PATH_1_0="$appdir/usr/lib/gstreamer-1.0"
export GST_PLUGIN_SCANNER="$appdir/usr/libexec/buzzardos/gst-plugin-scanner"
export GST_PLUGIN_SCANNER_1_0="$GST_PLUGIN_SCANNER"
export SPA_PLUGIN_DIR="$appdir/usr/lib/spa-0.2"

real_uid=
while IFS=' 	' read -r status_key status_value status_rest; do
    case $status_key in
        Uid:)
            real_uid=$status_value
            break
            ;;
    esac
done < /proc/self/status
case $real_uid in
    ''|*[!0-9]*)
        printf '%s\n' \
            'AppRun: could not determine the real UID from /proc/self/status' >&2
        exit 1
        ;;
esac

runtime_dir=${XDG_RUNTIME_DIR:-/tmp}
export GST_REGISTRY_1_0="$runtime_dir/buzzardos-gstreamer-registry-$real_uid.bin"
desktop_file="$appdir/org.openresearchtools.buzzardos.desktop"
if [ -f "$desktop_file" ]; then
    export GIO_LAUNCHED_DESKTOP_FILE="$desktop_file"
    export GIO_LAUNCHED_DESKTOP_FILE_PID=$$
fi
exec "$appdir/usr/bin/buzzardos" "$@"
